@model Pickleball_Smash.Models.ViewModels.UserSanChiTietViewModel

@{
    ViewData["Title"] = $"Chi Tiết Sân {Model.San.TenSan}";
    var trangThai = Model.San.TrangThai?.Trim() ?? string.Empty;
    var isMoCua = trangThai.Equals("Mở", StringComparison.OrdinalIgnoreCase)
        || trangThai.Equals("Hoạt động", StringComparison.OrdinalIgnoreCase)
        || trangThai.Equals("Open", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/user-chi-tiet-san.css" asp-append-version="true" />
}

<div class="container-fluid py-5">
    <div class="row">
        <!-- Hình Ảnh -->
        <div class="col-lg-7 mb-4">
            <div class="user-court-main-image-placeholder">
                <i class="fas fa-th"></i>
            </div>
            <div class="row g-2">
                <div class="col-md-3">
                    <div class="user-court-thumb-placeholder"></div>
                </div>
                <div class="col-md-3">
                    <div class="user-court-thumb-placeholder"></div>
                </div>
                <div class="col-md-3">
                    <div class="user-court-thumb-placeholder"></div>
                </div>
                <div class="col-md-3">
                    <div class="user-court-thumb-placeholder"></div>
                </div>
            </div>
        </div>

        <!-- Thông Tin -->
        <div class="col-lg-5">
            <h1 class="mb-3">@Model.San.TenSan</h1>

            <div class="mb-3">
                <p class="text-muted mb-0">
                    <i class="fas fa-map-marker-alt"></i> @Model.San.ChiNhanh?.TenChiNhanh
                </p>
                <p class="text-muted mb-0">
                    <i class="fas fa-phone"></i> @Model.San.ChiNhanh?.SDT_LienHe
                </p>
                <p class="text-muted">
                    <i class="fas fa-map-signs"></i> @Model.San.ChiNhanh?.DiaChi
                </p>
            </div>

            <div class="mb-3">
                <span class="badge bg-lg bg-info p-2">@Model.San.LoaiSan</span>
                @if (isMoCua)
                {
                    <span class="badge bg-lg bg-success p-2">
                        <i class="fas fa-check-circle"></i> Mở cửa
                    </span>
                }
                else
                {
                    <span class="badge bg-lg bg-danger p-2">
                        <i class="fas fa-times-circle"></i> Đóng cửa
                    </span>
                }
            </div>

            <h3 class="text-primary mb-4">
                @(Model.San.GiaCoBan?.ToString("N0") ?? "0") <small>VNĐ/giờ</small>
            </h3>

            <div class="mb-4">
                <h5>Mô Tả</h5>
                <p>@Model.San.MoTa</p>
            </div>

            <div class="mb-4">
                <h5>Tiện Nghi</h5>
                <div class="row">
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check-circle text-success"></i> Điều hòa 16°C</li>
                            <li><i class="fas fa-check-circle text-success"></i> Vợt miễn phí</li>
                            <li><i class="fas fa-check-circle text-success"></i> Nước miễn phí</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check-circle text-success"></i> Giặt, may sẵn</li>
                            <li><i class="fas fa-check-circle text-success"></i> Phòng tắm</li>
                            <li><i class="fas fa-check-circle text-success"></i> Quán ăn</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h5>Đánh Giá</h5>
                <div class="mb-2">
                    <span class="badge bg-warning text-dark p-2">⭐ @Model.DiemTrungBinh/5.0</span>
                    <small>(@Model.SoLuongDanhGia đánh giá)</small>
                </div>
                <div class="progress review-progress-track">
                    <div class="progress-bar bg-warning review-progress-bar" role="progressbar" data-width="@(Model.DiemTrungBinh * 20)"></div>
                </div>
            </div>

            @if (isMoCua)
            {
                <a asp-controller="User" asp-action="DatSan" asp-route-id="@Model.San.SanID" 
                   class="btn btn-primary btn-lg w-100">
                    <i class="fas fa-calendar-alt"></i> Đặt Sân Ngay
                </a>
            }
        </div>
    </div>

    <!-- Review -->
    <div class="row mt-5">
        <div class="col-lg-8">
            <h3 class="mb-4">Đánh Giá Từ Khách Hàng</h3>

            @if (Model.DanhGias.Any())
            {
                @foreach (var danhGia in Model.DanhGias)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h6>@(danhGia.NguoiDung?.HoTen ?? "Khách hàng")</h6>
                                <span class="text-muted">@danhGia.NgayDanhGia?.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <p class="text-warning">@(new string('*', danhGia.SoSao ?? 0) + new string('o', 5 - (danhGia.SoSao ?? 0)))</p>
                            <p class="card-text">@(string.IsNullOrWhiteSpace(danhGia.BinhLuan) ? "Không có bình luận." : danhGia.BinhLuan)</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">Sân này chưa có đánh giá nào.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var width = parseFloat($('.review-progress-bar').data('width')) || 0;
            width = Math.max(0, Math.min(width, 100));
            $('.review-progress-bar').css('width', width + '%');
        });
    </script>
}
