@{
    ViewData["Title"] = "Giỏ Hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/user-gio-hang.css" asp-append-version="true" />
}

<div class="container-fluid py-5">
    <h1 class="mb-4"><i class="fas fa-shopping-cart"></i> Giỏ Hàng</h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-body">
                    <h5 class="mb-3">Đơn Hàng</h5>

                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Sản Phẩm</th>
                                    <th>Ngày</th>
                                    <th>Giá</th>
                                    <th>Số Lượng</th>
                                    <th>Tổng</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Sân Cầu Lông 1</td>
                                    <td>28/03/2026</td>
                                    <td>350,000 VNĐ</td>
                                    <td>
                                        <input type="number" class="form-control cart-quantity-input" value="1" min="1">
                                    </td>
                                    <td><strong>350,000 VNĐ</strong></td>
                                    <td>
                                        <button class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Nước cam</td>
                                    <td>28/03/2026</td>
                                    <td>50,000 VNĐ</td>
                                    <td>
                                        <input type="number" class="form-control cart-quantity-input" value="1" min="1">
                                    </td>
                                    <td><strong>50,000 VNĐ</strong></td>
                                    <td>
                                        <button class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h5 class="m-0">Tóm Tắt Đơn Hàng</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <span>400,000 VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Giảm giá:</span>
                        <span class="text-danger">-50,000 VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Phí vận chuyển:</span>
                        <span>0 VNĐ</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <strong>Tổng cộng:</strong>
                        <strong class="cart-total-price">350,000 VNĐ</strong>
                    </div>

                    <div class="mb-3">
                        <input type="text" class="form-control" placeholder="Mã voucher...">
                    </div>

                    <button class="btn btn-primary w-100 mb-2">
                        <i class="fas fa-tag"></i> Áp Dụng Voucher
                    </button>
                    <button class="btn btn-success w-100">
                        <i class="fas fa-credit-card"></i> Thanh Toán
                    </button>
                </div>
            </div>

            <div class="card shadow mt-3">
                <div class="card-body">
                    <h6 class="mb-3">Bảo Hành</h6>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-check text-success"></i> Tiền hoàn lại 100% nếu huỷ trước 2h</li>
                        <li><i class="fas fa-check text-success"></i> Hỗ trợ 24/7</li>
                        <li><i class="fas fa-check text-success"></i> Thanh toán an toàn</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
