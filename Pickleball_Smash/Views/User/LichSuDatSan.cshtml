@model IEnumerable<Pickleball_Smash.Models.DonDatSan>

@{
    ViewData["Title"] = "Lịch Sử Đặt Sân";
}

<div class="container-fluid py-5">
    <h1 class="mb-4"><i class="fas fa-history"></i> Lịch Sử Đặt Sân</h1>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Sân</th>
                            <th>Ngày Đặt</th>
                            <th>Thời Gian</th>
                            <th>Giá</th>
                            <th>Trạng Thái</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var don in Model)
                            {
                                <tr>
                                    <td><strong>#@don.DonDatSanID</strong></td>
                                    <td>@don.SanPickleball?.TenSan</td>
                                    <td>@don.NgayChoi?.ToString("dd/MM/yyyy")</td>
                                    <td>@don.ThoiGianBatDau?.ToString(@"hh\:mm") - @don.ThoiGianKetThuc?.ToString(@"hh\:mm")</td>
                                    <td><strong>@(don.TongTien?.ToString("N0") ?? "0") VNĐ</strong></td>
                                    <td>
                                        @{
                                            var trangThaiClass = don.TrangThaiDon switch
                                            {
                                                "Chờ xác nhận" => "warning",
                                                "Đã xác nhận" => "info",
                                                "Đã hoàn thành" => "success",
                                                "Đã huỷ" => "danger",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@trangThaiClass">@don.TrangThaiDon</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        @if (don.TrangThaiDon == "Chờ xác nhận")
                                        {
                                            <button class="btn btn-sm btn-danger">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox"></i> Chưa có đơn đặt sân nào
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
