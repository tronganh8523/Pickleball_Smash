@model Pickleball_Smash.Models.ViewModels.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Manager";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/manager-dashboard.css" asp-append-version="true" />
}

<div class="summary-grid">
    <article class="summary-card green">
        <p>Tổng số sân</p>
        <h3>@Model.TongSan</h3>
    </article>
    <article class="summary-card blue">
        <p>Sân còn trống</p>
        <h3>@Model.TongSanConTrong</h3>
    </article>
    <article class="summary-card orange">
        <p>Đơn chờ xác nhận</p>
        <h3>@Model.TongDonChoXacNhan</h3>
    </article>
    <article class="summary-card red">
        <p>Sân đang bận</p>
        <h3>@Model.TongSanDangBan</h3>
    </article>
</div>

<section class="court-grid-wrap">
    <h2>Danh sách sân</h2>

    @{
        var loaiSanOptions = ViewBag.LoaiSanOptions as List<string> ?? new List<string>();
        var trangThaiOptions = ViewBag.TrangThaiOptions as List<string> ?? new List<string>();
        var selectedTenSan = ViewBag.SelectedTenSan as string;
        var selectedLoaiSan = ViewBag.SelectedLoaiSan as string;
        var selectedTrangThai = ViewBag.SelectedTrangThai as string;
    }

    <form id="courtFilterForm" method="get" asp-controller="Manager" asp-action="Dashboard" class="court-filter-form">
        <div class="filter-group">
            <label for="tenSan">Tên sân</label>
            <input id="tenSan" name="tenSan" type="text" class="form-control" value="@selectedTenSan" placeholder="Nhập tên sân" />
        </div>

        <div class="filter-group">
            <label for="loaiSan">Loại sân</label>
            <select id="loaiSan" name="loaiSan" class="form-select">
                <option value="">Tất cả loại sân</option>
                @foreach (var loai in loaiSanOptions)
                {
                    <option value="@loai" selected="@(string.Equals(selectedLoaiSan, loai, StringComparison.OrdinalIgnoreCase))">@loai</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="trangThai">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (var tt in trangThaiOptions)
                {
                    <option value="@tt" selected="@(string.Equals(selectedTrangThai, tt, StringComparison.OrdinalIgnoreCase))">@tt</option>
                }
            </select>
        </div>

        <div class="filter-actions">
            <button type="button" id="clearFilterBtn" class="btn btn-outline-secondary">Bỏ lọc</button>
        </div>
    </form>

    <div id="courtGridContainer">
        @await Html.PartialAsync("~/Views/Manager/_CourtGrid.cshtml", Model)
    </div>
</section>

<div id="bookingOverlay" class="booking-overlay" hidden>
    <div class="booking-overlay-backdrop"></div>
    <div class="booking-modal" role="dialog" aria-modal="true" aria-labelledby="bookingModalTitle">
        <button type="button" class="booking-close" id="bookingCloseBtn" aria-label="Đóng">x</button>

        <h3 id="bookingModalTitle">Đặt sân</h3>

        <div class="booking-layout">
            <form id="bookingForm" class="booking-form" novalidate>
                <div class="form-row">
                    <label for="bookingCustomer">Khách hàng</label>
                    <input id="bookingCustomer" type="text" class="form-control" placeholder="Nhập tên khách hàng" />
                </div>

                <div class="form-row">
                    <label for="bookingPhone">Số điện thoại</label>
                    <input id="bookingPhone" type="text" class="form-control" placeholder="Nhập số điện thoại" />
                </div>

                <div class="form-row">
                    <label for="bookingDate">Ngày đặt</label>
                    <input id="bookingDate" type="date" class="form-control" />
                </div>

                <div class="form-row form-row-full">
                    <label for="bookingCourtDisplay">Sân đang đặt</label>
                    <input id="bookingCourtDisplay" type="text" class="form-control" readonly placeholder="Chưa chọn sân" />
                    <input id="bookingCourt" type="hidden" value="" />
                </div>

                <div class="form-row">
                    <label for="bookingStart">Giờ bắt đầu</label>
                    <select id="bookingStart" class="form-select">
                        @for (var hour = 5; hour <= 23; hour++)
                        {
                            var label = $"{hour:00}:00";
                            <option value="@label">@label</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <label for="bookingEnd">Giờ kết thúc</label>
                    <select id="bookingEnd" class="form-select">
                        @for (var hour = 6; hour <= 24; hour++)
                        {
                            var label = $"{hour:00}:00";
                            <option value="@label">@label</option>
                        }
                    </select>
                </div>

            </form>

            <aside class="booking-summary">
                <h5>Tóm tắt đặt sân</h5>

                <div class="summary-item"><span>Khách hàng</span><strong id="sumCustomer">-</strong></div>
                <div class="summary-item"><span>Loại sân</span><strong id="sumLoaiSan">-</strong></div>
                <div class="summary-item"><span>Số điện thoại</span><strong id="sumPhone">-</strong></div>
                <div class="summary-item"><span>Khung giờ</span><strong id="sumTime">-</strong></div>
                <div class="summary-item"><span>Ngày đặt sân</span><strong id="sumDate">-</strong></div>
                <hr />

                <div class="summary-item"><span>Tổng tiền</span><strong id="sumTotal">0 đ</strong></div>
                <button id="bookingSubmitBtn" type="button" class="btn btn-primary w-100 mt-2">Đặt Sân</button>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const createBookingUrl = '@Url.Action("CreateBooking", "Manager")';
            const lookupCustomerByPhoneUrl = '@Url.Action("LookupCustomerByPhone", "Manager")';
            const hasSwal = typeof Swal !== "undefined";
            const overlay = document.getElementById("bookingOverlay");
            const backdrop = overlay?.querySelector(".booking-overlay-backdrop");
            const closeBtn = document.getElementById("bookingCloseBtn");
            const bookingCourt = document.getElementById("bookingCourt");
            const bookingCourtDisplay = document.getElementById("bookingCourtDisplay");
            const bookingCustomer = document.getElementById("bookingCustomer");
            const bookingPhone = document.getElementById("bookingPhone");
            const bookingDate = document.getElementById("bookingDate");
            const bookingStart = document.getElementById("bookingStart");
            const bookingEnd = document.getElementById("bookingEnd");
            const bookingSubmitBtn = document.getElementById("bookingSubmitBtn");
            const courtFilterForm = document.getElementById("courtFilterForm");
            const tenSanInput = document.getElementById("tenSan");
            const loaiSanSelect = document.getElementById("loaiSan");
            const trangThaiSelect = document.getElementById("trangThai");
            const clearFilterBtn = document.getElementById("clearFilterBtn");
            const courtGridContainer = document.getElementById("courtGridContainer");

            const sumCustomer = document.getElementById("sumCustomer");
            const sumLoaiSan = document.getElementById("sumLoaiSan");
            const sumPhone = document.getElementById("sumPhone");
            const sumTime = document.getElementById("sumTime");
            const sumDate = document.getElementById("sumDate");
            const sumTotal = document.getElementById("sumTotal");

            let selectedCourtPrice = 0;
            let selectedCourtLoaiSan = "-";
            let bookedRanges = [];
            let pricingRanges = [];
            let filterDebounceId;
            let filterAbortController = null;
            let phoneLookupDebounceId;
            let phoneLookupAbortController = null;

            const formatVnd = (value) => `${new Intl.NumberFormat("vi-VN").format(value)} đ`;

            const showError = async (message) => {
                if (!hasSwal) {
                    alert(message);
                    return;
                }

                await Swal.fire({
                    icon: "error",
                    title: "Có lỗi xảy ra",
                    text: message,
                    confirmButtonText: "Đã hiểu"
                });
            };

            const getTodayDateString = () => {
                const now = new Date();
                const month = String(now.getMonth() + 1).padStart(2, "0");
                const day = String(now.getDate()).padStart(2, "0");
                return `${now.getFullYear()}-${month}-${day}`;
            };

            const showSuccess = async (message) => {
                if (!hasSwal) {
                    alert(message);
                    return;
                }

                await Swal.fire({
                    icon: "success",
                    title: "Thành công",
                    text: message,
                    confirmButtonText: "OK"
                });
            };

            const showWarning = async (message) => {
                if (!hasSwal) {
                    alert(message);
                    return;
                }

                await Swal.fire({
                    icon: "warning",
                    title: "Thiếu thông tin",
                    text: message,
                    confirmButtonText: "OK"
                });
            };

            const confirmAction = async (message) => {
                if (!hasSwal) {
                    return confirm(message);
                }

                const result = await Swal.fire({
                    icon: "question",
                    title: "Xác nhận",
                    text: message,
                    showCancelButton: true,
                    confirmButtonText: "Đồng ý",
                    cancelButtonText: "Hủy"
                });

                return !!result.isConfirmed;
            };

            const runFilterRefresh = () => {
                return refreshCourts().catch(error => {
                    if (error && error.name === "AbortError") {
                        return;
                    }

                    return showError("Không thể tải danh sách sân. Vui lòng thử lại.");
                });
            };

            const bindCourtActionButtons = () => {
                document.querySelectorAll(".js-open-booking").forEach(btn => {
                    btn.addEventListener("click", function () {
                        openModal(this);
                    });
                });

            };

            const buildFilterUrl = () => {
                const url = new URL(courtFilterForm.action, window.location.origin);
                const formData = new FormData(courtFilterForm);

                for (const [key, value] of formData.entries()) {
                    const normalized = typeof value === "string" ? value.trim() : value;
                    if (normalized) {
                        url.searchParams.set(key, normalized);
                    }
                }

                return url;
            };

            const refreshCourts = async () => {
                if (!courtGridContainer || !courtFilterForm) return;

                if (filterAbortController) {
                    filterAbortController.abort();
                }

                filterAbortController = new AbortController();

                const url = buildFilterUrl();
                const response = await fetch(url.toString(), {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "Accept": "text/html"
                    },
                    signal: filterAbortController.signal
                });

                if (!response.ok) {
                    throw new Error("Filter request failed");
                }

                const html = await response.text();
                courtGridContainer.innerHTML = html;
                bindCourtActionButtons();
            };

            const setTodayIfEmpty = () => {
                if (!bookingDate || bookingDate.value) return;
                const now = new Date();
                const month = String(now.getMonth() + 1).padStart(2, "0");
                const day = String(now.getDate()).padStart(2, "0");
                bookingDate.value = `${now.getFullYear()}-${month}-${day}`;
            };

            const parseHourValue = (value) => {
                if (!value) return NaN;
                const parts = value.split(":");
                const hour = Number(parts[0]);
                if (Number.isNaN(hour)) return NaN;
                return hour === 24 ? 24 : hour;
            };

            const hasBookingOverlap = (startHour, endHour) => {
                return bookedRanges.some(range => startHour < range.end && endHour > range.start);
            };

            const getPriceByHour = (hour) => {
                const slot = pricingRanges.find(x => x.start <= hour && hour < x.end);
                return slot ? slot.price : selectedCourtPrice;
            };

            const loadCourtBookings = async () => {
                const sanId = Number(bookingCourt?.value || 0);
                const ngayChoi = bookingDate?.value?.trim();

                if (!sanId || !ngayChoi) {
                    bookedRanges = [];
                    pricingRanges = [];
                    renderBookingTimeOptions();
                    return;
                }

                try {
                    const url = new URL('@Url.Action("GetCourtBookingsForDay", "Manager")', window.location.origin);
                    url.searchParams.set("sanId", String(sanId));
                    url.searchParams.set("ngayChoi", ngayChoi);

                    const response = await fetch(url.toString(), {
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    if (!response.ok) {
                        bookedRanges = [];
                        pricingRanges = [];
                        renderBookingTimeOptions();
                        return;
                    }

                    const result = await response.json();
                    const bookings = result?.bookings || [];
                    const ranges = result?.pricingRanges || [];

                    bookedRanges = bookings
                        .map(b => ({
                            start: parseHourValue(b.gioBatDau),
                            end: parseHourValue(b.gioKetThuc)
                        }))
                        .filter(x => !Number.isNaN(x.start) && !Number.isNaN(x.end) && x.end > x.start);

                    pricingRanges = ranges
                        .map(x => ({
                            start: Number(x.startHour),
                            end: Number(x.endHour),
                            price: Number(x.giaTien)
                        }))
                        .filter(x => !Number.isNaN(x.start) && !Number.isNaN(x.end) && !Number.isNaN(x.price) && x.end > x.start)
                        .sort((a, b) => a.start - b.start);

                    renderBookingTimeOptions();
                } catch (error) {
                    bookedRanges = [];
                    pricingRanges = [];
                    renderBookingTimeOptions();
                }
            };

            const populateBookingEndOptions = (startHour, previousEnd) => {
                if (!bookingEnd) return;

                bookingEnd.innerHTML = "";

                const firstEndHour = Math.max(startHour + 1, 6);
                for (let hour = firstEndHour; hour <= 24; hour++) {
                    if (hasBookingOverlap(startHour, hour)) {
                        continue;
                    }

                    const label = `${String(hour).padStart(2, "0")}:00`;
                    const option = document.createElement("option");
                    option.value = label;
                    option.textContent = label;
                    bookingEnd.appendChild(option);
                }

                if (previousEnd && bookingEnd.querySelector(`option[value="${previousEnd}"]`)) {
                    bookingEnd.value = previousEnd;
                } else if (bookingEnd.firstElementChild) {
                    bookingEnd.value = bookingEnd.firstElementChild.value;
                } else {
                    bookingEnd.value = "";
                }
            };

            const renderBookingTimeOptions = () => {
                if (!bookingDate || !bookingStart || !bookingEnd) return;

                const today = getTodayDateString();
                const isToday = bookingDate.value === today;
                const currentHour = new Date().getHours();
                const firstAllowedStart = isToday ? currentHour + 1 : 5;

                const previousStart = bookingStart.value;
                const previousEnd = bookingEnd.value;

                bookingStart.innerHTML = "";

                if (isToday && firstAllowedStart > 23) {
                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = "Hết khung giờ hôm nay";
                    option.disabled = true;
                    option.selected = true;
                    bookingStart.appendChild(option);
                    bookingEnd.innerHTML = "";
                    bookingEnd.value = "";
                    updateSummary();
                    return;
                }

                for (let hour = firstAllowedStart; hour <= 23; hour++) {
                    if (hasBookingOverlap(hour, hour + 1)) {
                        continue;
                    }

                    const label = `${String(hour).padStart(2, "0")}:00`;
                    const option = document.createElement("option");
                    option.value = label;
                    option.textContent = label;
                    bookingStart.appendChild(option);
                }

                if (!bookingStart.firstElementChild) {
                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = "Không còn giờ trống";
                    option.disabled = true;
                    option.selected = true;
                    bookingStart.appendChild(option);
                    bookingEnd.innerHTML = "";
                    bookingEnd.value = "";
                    updateSummary();
                    return;
                }

                if (previousStart && bookingStart.querySelector(`option[value="${previousStart}"]`)) {
                    bookingStart.value = previousStart;
                } else if (bookingStart.firstElementChild) {
                    bookingStart.value = bookingStart.firstElementChild.value;
                }

                const selectedStartHour = Number((bookingStart.value || "0").split(":")[0]);
                populateBookingEndOptions(selectedStartHour, previousEnd);

                if (bookingEnd.value && Number((bookingEnd.value || "0").split(":")[0]) <= selectedStartHour) {
                    bookingEnd.value = "";
                }

                if (!bookingEnd.value && bookingEnd.firstElementChild) {
                    bookingEnd.value = bookingEnd.firstElementChild.value;
                }

                updateSummary();
            };

            const scheduleLiveFilter = () => {
                if (!courtFilterForm) return;

                window.clearTimeout(filterDebounceId);
                filterDebounceId = window.setTimeout(() => {
                    runFilterRefresh();
                }, 350);
            };

            const schedulePhoneLookup = () => {
                window.clearTimeout(phoneLookupDebounceId);
                phoneLookupDebounceId = window.setTimeout(() => {
                    lookupCustomerByPhone();
                }, 350);
            };

            const lookupCustomerByPhone = async () => {
                if (!bookingPhone || !bookingCustomer) return;

                const phone = bookingPhone.value.trim();
                if (!phone) {
                    return;
                }

                if (phoneLookupAbortController) {
                    phoneLookupAbortController.abort();
                }

                phoneLookupAbortController = new AbortController();

                try {
                    const url = new URL(lookupCustomerByPhoneUrl, window.location.origin);
                    url.searchParams.set("soDienThoai", phone);

                    const response = await fetch(url.toString(), {
                        headers: {
                            "Accept": "application/json"
                        },
                        signal: phoneLookupAbortController.signal
                    });

                    if (!response.ok) {
                        return;
                    }

                    const result = await response.json();
                    if (result?.found && result?.hoTen) {
                        bookingCustomer.value = result.hoTen;
                        updateSummary();
                    }
                } catch (error) {
                    if (error && error.name === "AbortError") {
                        return;
                    }
                }
            };

            const updateSummary = () => {
                const startVal = bookingStart?.value || "-";
                const endVal = bookingEnd?.value || "-";

                sumCustomer.textContent = bookingCustomer?.value?.trim() || "-";
                sumLoaiSan.textContent = selectedCourtLoaiSan;
                sumPhone.textContent = bookingPhone?.value?.trim() || "-";
                sumTime.textContent = `${startVal} - ${endVal}`;
                sumDate.textContent = bookingDate?.value || "-";

                const startHour = Number((bookingStart?.value || "0").split(":")[0]);
                const endHour = Number((bookingEnd?.value || "0").split(":")[0]);

                if (Number.isNaN(startHour) || Number.isNaN(endHour) || endHour <= startHour) {
                    sumTotal.textContent = formatVnd(0);
                    return;
                }

                let total = 0;
                for (let hour = startHour; hour < endHour; hour++) {
                    total += getPriceByHour(hour);
                }

                sumTotal.textContent = formatVnd(total);
            };

            const validateForm = async () => {
                if (!bookingCourt?.value) {
                    await showWarning("Vui lòng chọn sân.");
                    return false;
                }

                if (!bookingCustomer?.value?.trim() || !bookingPhone?.value?.trim()) {
                    await showWarning("Vui lòng nhập khách hàng và số điện thoại.");
                    return false;
                }

                if (!bookingDate?.value) {
                    await showWarning("Vui lòng chọn ngày đặt.");
                    return false;
                }

                const today = getTodayDateString();
                if (bookingDate.value < today) {
                    await showWarning("Không thể đặt sân cho ngày trong quá khứ.");
                    return false;
                }

                if (bookingDate.value === today) {
                    const currentTime = new Date();
                    const currentMinutes = currentTime.getHours() * 60 + currentTime.getMinutes();
                    const startHourValue = Number((bookingStart?.value || "0").split(":")[0]);
                    const startMinutes = startHourValue * 60;

                    if (startMinutes <= currentMinutes) {
                        await showWarning("Không thể đặt sân cho khung giờ đã qua trong ngày hôm nay.");
                        return false;
                    }
                }

                if (!bookingStart?.value) {
                    await showWarning("Vui lòng chọn giờ bắt đầu hợp lệ.");
                    return false;
                }

                if ((bookingEnd?.value || "") <= (bookingStart?.value || "")) {
                    await showWarning("Giờ kết thúc phải lớn hơn giờ bắt đầu.");
                    return false;
                }

                return true;
            };

            const openModal = (button) => {
                if (!overlay) return;

                setTodayIfEmpty();

                const sanId = button?.dataset?.sanId;
                if (bookingCourt && sanId) {
                    const tenSan = button?.dataset?.tenSan || `Sân ${sanId}`;
                    const loaiSan = button?.dataset?.loaiSan || "-";
                    const gia = button?.dataset?.gia || "0";

                    bookingCourt.value = String(sanId);
                    if (bookingCourtDisplay) {
                        bookingCourtDisplay.value = tenSan;
                    }
                    selectedCourtLoaiSan = loaiSan;
                    selectedCourtPrice = Number(gia);
                }

                updateSummary();
                loadCourtBookings();

                overlay.hidden = false;
                overlay.style.display = "grid";
                document.body.classList.add("booking-open");
            };

            const closeModal = () => {
                if (!overlay) return;
                overlay.hidden = true;
                overlay.style.display = "none";
                document.body.classList.remove("booking-open");
            };

            bindCourtActionButtons();

            if (bookingDate) {
                bookingDate.min = getTodayDateString();
            }

            closeBtn?.addEventListener("click", closeModal);
            backdrop?.addEventListener("click", closeModal);

            [bookingCustomer, bookingPhone, bookingDate, bookingStart, bookingEnd].forEach(input => {
                input?.addEventListener("input", updateSummary);
                input?.addEventListener("change", updateSummary);
            });

            bookingPhone?.addEventListener("input", schedulePhoneLookup);
            bookingPhone?.addEventListener("blur", lookupCustomerByPhone);

            bookingDate?.addEventListener("change", function () {
                loadCourtBookings();
            });

            bookingStart?.addEventListener("change", function () {
                const startHour = Number((this.value || "0").split(":")[0]);
                const previousEnd = bookingEnd?.value || "";

                populateBookingEndOptions(startHour, previousEnd);

                updateSummary();
            });

            tenSanInput?.addEventListener("input", scheduleLiveFilter);
            loaiSanSelect?.addEventListener("change", runFilterRefresh);
            trangThaiSelect?.addEventListener("change", runFilterRefresh);

            courtFilterForm?.addEventListener("submit", function (event) {
                event.preventDefault();
                runFilterRefresh();
            });

            clearFilterBtn?.addEventListener("click", function () {
                if (tenSanInput) tenSanInput.value = "";
                if (loaiSanSelect) loaiSanSelect.value = "";
                if (trangThaiSelect) trangThaiSelect.value = "";
                runFilterRefresh();
            });

            bookingSubmitBtn?.addEventListener("click", async function () {
                if (!await validateForm()) {
                    return;
                }

                const payload = {
                    sanID: Number(bookingCourt?.value || 0),
                    tenKhachHang: bookingCustomer?.value?.trim() || "",
                    soDienThoai: bookingPhone?.value?.trim() || "",
                    ngayChoi: bookingDate?.value || "",
                    gioBatDau: bookingStart?.value || "",
                    gioKetThuc: bookingEnd?.value || ""
                };

                const originalText = this.textContent;
                this.disabled = true;
                this.textContent = "Đang lưu...";

                try {
                    const response = await fetch(createBookingUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();
                    if (!response.ok || !result?.success) {
                        await showError(result?.message || "Không thể đặt sân. Vui lòng thử lại.");
                        return;
                    }

                    closeModal();
                    this.disabled = false;
                    this.textContent = originalText;

                    await showSuccess(`Đặt sân thành công. Mã đơn #${result.bookingId}`);
                    window.location.reload();
                } catch (error) {
                    await showError("Lỗi kết nối máy chủ. Vui lòng thử lại.");
                } finally {
                    this.disabled = false;
                    this.textContent = originalText;
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && overlay && !overlay.hidden) {
                    closeModal();
                }
            });
        })();
    </script>
}