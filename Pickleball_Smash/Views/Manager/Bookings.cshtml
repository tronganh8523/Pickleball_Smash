@model IEnumerable<Pickleball_Smash.Models.DonDatSan>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Danh sách đặt sân";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var sanOptions = ViewBag.SanOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var khungGioOptions = ViewBag.KhungGioOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var trangThaiOptions = ViewBag.TrangThaiOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var selectedSanId = ViewBag.SelectedSanId?.ToString() ?? string.Empty;
    var selectedKhungGio = ViewBag.SelectedKhungGio as string ?? string.Empty;
    var selectedNgayChoiTu = ViewBag.SelectedNgayChoiTu as string ?? string.Empty;
    var selectedNgayChoiDen = ViewBag.SelectedNgayChoiDen as string ?? string.Empty;
    var selectedTrangThai = ViewBag.SelectedTrangThai as string ?? string.Empty;
    var selectedSapXep = ViewBag.SelectedSapXep as string ?? "created_desc";
    var selectedTuKhoa = ViewBag.SelectedTuKhoa as string ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/manager-dashboard.css" asp-append-version="true" />
}

<div class="manager-page-head">
    <h1>Danh sách đặt sân</h1>
    <p>Theo dõi toàn bộ đơn đặt sân theo thời gian tạo mới nhất.</p>
</div>

<div class="table-card mb-3">
    <form method="get" asp-controller="ManagerDonDatSan" asp-action="Bookings" class="court-filter-form bookings-filter-form">
        <div class="filter-group">
            <label for="sanId">Sân</label>
            <select id="sanId" name="sanId" class="form-select">
                <option value="">Tất cả sân</option>
                @foreach (var san in sanOptions)
                {
                    
                    if (selectedSanId == san.Value)
                    {
                        <option value="@san.Value" selected>@san.Text</option>
                    }
                    else
                    {
                        <option value="@san.Value">@san.Text</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="khungGio">Khung giờ</label>
            <select id="khungGio" name="khungGio" class="form-select">
                <option value="">Tất cả khung giờ</option>
                @foreach (var khungGio in khungGioOptions)
                {
                    if (string.Equals(selectedKhungGio, khungGio.Value, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@khungGio.Value" selected>@khungGio.Text</option>
                    }
                    else
                    {
                        <option value="@khungGio.Value">@khungGio.Text</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="tuKhoa">Tìm kiếm Tên/SĐT</label>
            <input id="tuKhoa" name="tuKhoa" type="text" class="form-control" value="@selectedTuKhoa" placeholder="Nhập tên hoặc số điện thoại" />
        </div>

        <div class="filter-group">
            <label for="ngayChoiTu">Ngày chơi từ</label>
            <input id="ngayChoiTu" name="ngayChoiTu" type="date" class="form-control" value="@selectedNgayChoiTu" />
        </div>

        <div class="filter-group">
            <label for="ngayChoiDen">Ngày chơi đến</label>
            <input id="ngayChoiDen" name="ngayChoiDen" type="date" class="form-control" value="@selectedNgayChoiDen" />
        </div>

        <div class="filter-group">
            <label for="trangThai">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (var status in trangThaiOptions)
                {
                    if (string.Equals(selectedTrangThai, status.Value, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@status.Value" selected>@status.Text</option>
                    }
                    else
                    {
                        <option value="@status.Value">@status.Text</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="sapXep">Sắp xếp</label>
            <select id="sapXep" name="sapXep" class="form-select">
                @if (selectedSapXep == "created_desc")
                {
                    <option value="created_desc" selected>Ngày tạo mới nhất</option>
                }
                else
                {
                    <option value="created_desc">Ngày tạo mới nhất</option>
                }
                @if (selectedSapXep == "created_asc")
                {
                    <option value="created_asc" selected>Ngày tạo cũ nhất</option>
                }
                else
                {
                    <option value="created_asc">Ngày tạo cũ nhất</option>
                }
                @if (selectedSapXep == "playdate_desc")
                {
                    <option value="playdate_desc" selected>Ngày chơi mới nhất</option>
                }
                else
                {
                    <option value="playdate_desc">Ngày chơi mới nhất</option>
                }
                @if (selectedSapXep == "playdate_asc")
                {
                    <option value="playdate_asc" selected>Ngày chơi cũ nhất</option>
                }
                else
                {
                    <option value="playdate_asc">Ngày chơi cũ nhất</option>
                }
                @if (selectedSapXep == "total_desc")
                {
                    <option value="total_desc" selected>Tổng tiền cao đến thấp</option>
                }
                else
                {
                    <option value="total_desc">Tổng tiền cao đến thấp</option>
                }
                @if (selectedSapXep == "total_asc")
                {
                    <option value="total_asc" selected>Tổng tiền thấp đến cao</option>
                }
                else
                {
                    <option value="total_asc">Tổng tiền thấp đến cao</option>
                }
            </select>
        </div>

        <div class="filter-actions align-self-end">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-controller="ManagerDonDatSan" asp-action="Bookings" class="btn btn-outline-secondary">Bỏ lọc</a>
        </div>
    </form>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Sân</th>
                    <th>Khung giờ</th>
                    <th>Ngày chơi</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        // Razor tự động hiểu đây là code C# vì nằm ngay trong @foreach
                        var daThanhToan = item.ThanhToans?.Sum(t => t.SoTien) ?? 0;
                        var tongTien = item.TongTien ?? 0;
                        var conLai = tongTien - daThanhToan;
                        var laDatCoc = daThanhToan > 0 && daThanhToan < tongTien;

                        <!-- Bôi đỏ dòng nếu khách hàng gửi yêu cầu hủy -->
                        <tr class="@(item.YeuCauHuy ? "table-danger" : (item.YeuCauSua ? "table-warning" : ""))">
                            <td>
                                #@item.DonDatSanID
                                @if (item.YeuCauHuy)
                                {
                                    <span class="badge bg-danger mt-1">Khách xin hủy</span>
                                }
                                @if (item.YeuCauSua)
                                {
                                    <span class="badge bg-warning text-dark mt-1">Khách xin sửa</span>
                                    <div style="font-size: 0.8rem; color: #dc3545; max-width: 180px; margin-top: 5px;">@item.NoiDungSua</div>
                                }
                            </td>
                            <td>@(item.NguoiDung?.HoTen ?? item.NguoiDung?.TenDangNhap ?? "Khách lẻ")</td>
                            <td>@(item.SanPickleball?.TenSan ?? "N/A")</td>
                            <td>
                                @Pickleball_Smash.Controllers.ManagerDonDatSanController.FormatBookingTimeRange(item)
                            </td>
                            <td>@(item.NgayChoi?.ToString("dd/MM/yyyy") ?? "-")</td>
                
                            <!-- CỘT HIỂN THỊ TIỀN -->
                            <td>
                                @if (laDatCoc)
                                {
                                    <div style="line-height: 1.4;">
                                        <span class="badge bg-warning text-dark mb-1" style="font-size: 0.9em;">Khách cọc: @daThanhToan.ToString("N0") đ</span><br />
                                        <small class="text-muted">Tổng: @tongTien.ToString("N0") đ</small>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-weight: bold;">@tongTien.ToString("N0") đ</span>
                                }
                            </td>
                
                            <!-- CỘT TRẠNG THÁI -->
                            <td>
                                @{
                                    var status = item.TrangThaiDon?.Trim() ?? "-";
                                    var statusClass = status.Equals("Chờ xác nhận", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark"
                                        : status.Equals("Đã xác nhận", StringComparison.OrdinalIgnoreCase) ? "bg-info text-dark"
                                        : status.Equals("Đang chơi", StringComparison.OrdinalIgnoreCase) ? "bg-success"
                                        : status.Equals("Đã đặt", StringComparison.OrdinalIgnoreCase) ? "bg-primary"
                                        : status.Equals("Hoàn thành", StringComparison.OrdinalIgnoreCase) ? "bg-secondary"
                                        : status.Equals("Đã hủy", StringComparison.OrdinalIgnoreCase) ? "bg-danger"
                                        : status.Equals("Đã hoàn tiền", StringComparison.OrdinalIgnoreCase) ? "bg-secondary"
                                        : status.Equals("Thất bại", StringComparison.OrdinalIgnoreCase) ? "bg-dark"
                                        : "bg-light text-dark";
                                }
                                <span class="badge @statusClass">@status</span>
                            </td>
                            <td>@(item.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                
                            <!-- CỘT CHỨA NÚT HÀNH ĐỘNG -->
                            <td>
                                @{
                                    var actionStatus = item.TrangThaiDon?.Trim() ?? string.Empty;
                                    var isWaiting = actionStatus.Equals("Chờ xác nhận", StringComparison.OrdinalIgnoreCase);
                                    var isConfirmed = actionStatus.Equals("Đã xác nhận", StringComparison.OrdinalIgnoreCase);
                                    var isPlaying = actionStatus.Equals("Đang chơi", StringComparison.OrdinalIgnoreCase);
                                }

                                <div class="d-flex flex-wrap gap-2">
                                    @if (isWaiting)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning js-edit-booking" data-booking-id="@item.DonDatSanID" data-san-id="@(item.SanID ?? 0)">Sửa</button>
                                        <button type="button" class="btn btn-sm btn-outline-success js-confirm-booking" data-booking-id="@item.DonDatSanID" data-san-id="@(item.SanID ?? 0)">Xác nhận</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger js-cancel-booking" data-booking-id="@item.DonDatSanID" data-san-id="@(item.SanID ?? 0)">Hủy</button>
                                    }
                                    else if (isConfirmed)
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" onclick="openCheckInModal(@item.DonDatSanID, @(item.SanID ?? 0), @conLai, @daThanhToan, @tongTien)">Check-in</button>
                                        @if (item.YeuCauHuy)
                                        {
                                            <button type="button" class="btn btn-sm btn-danger js-cancel-booking" data-booking-id="@item.DonDatSanID" data-san-id="@(item.SanID ?? 0)">Hủy & Hoàn tiền</button>
                                        }
                                    }
                                    else if (isPlaying)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary js-checkout-booking" data-booking-id="@item.DonDatSanID" data-san-id="@(item.SanID ?? 0)">Check-out</button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">Chưa có dữ liệu đơn đặt sân.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const confirmBookingUrl = '@Url.Action("ConfirmBooking", "ManagerDonDatSan")';
            const checkoutBookingUrl = '@Url.Action("CheckoutCourt", "ManagerDonDatSan")';
            const cancelBookingUrl = '@Url.Action("CancelBooking", "ManagerDonDatSan")';

            const showMessage = async (icon, title, text) => {
                if (typeof Swal === "undefined") {
                    alert(text);
                    return;
                }

                await Swal.fire({
                    icon,
                    title,
                    text,
                    confirmButtonText: "OK"
                });
            };

            const confirmAction = async (message) => {
                if (typeof Swal === "undefined") {
                    return confirm(message);
                }

                const result = await Swal.fire({
                    icon: "question",
                    title: "Xác nhận",
                    text: message,
                    showCancelButton: true,
                    confirmButtonText: "Đồng ý",
                    cancelButtonText: "Hủy"
                });

                return !!result.isConfirmed;
            };

            const submitBookingAction = async (url, payload, button, successText) => {
                const originalText = button.textContent;
                button.disabled = true;
                button.textContent = "Đang xử lý...";

                try {
                    const response = await fetch(url, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();
                    if (!response.ok || !result?.success) {
                        await showMessage("error", "Có lỗi xảy ra", result?.message || "Thao tác không thành công.");
                        return;
                    }

                    await showMessage("success", "Thành công", successText);
                    window.location.reload();
                } catch (error) {
                    await showMessage("error", "Có lỗi xảy ra", "Lỗi kết nối máy chủ. Vui lòng thử lại.");
                } finally {
                    button.disabled = false;
                    button.textContent = originalText;
                }
            };

            document.querySelectorAll(".js-confirm-booking").forEach(button => {
                button.addEventListener("click", async function () {
                    const bookingId = Number(this.dataset.bookingId || 0);
                    const sanId = Number(this.dataset.sanId || 0);

                    if (!bookingId || !sanId) {
                        await showMessage("error", "Có lỗi xảy ra", "Không tìm thấy dữ liệu đơn để xác nhận.");
                        return;
                    }

                    const ok = await confirmAction("Bạn muốn xác nhận đơn đặt sân này?");
                    if (!ok) {
                        return;
                    }

                    await submitBookingAction(confirmBookingUrl, { bookingID: bookingId, sanID: sanId }, this, "Đã xác nhận đơn đặt sân.");
                });
            });

            document.querySelectorAll(".js-checkout-booking").forEach(button => {
                button.addEventListener("click", async function () {
                    const bookingId = Number(this.dataset.bookingId || 0);
                    const sanId = Number(this.dataset.sanId || 0);

                    if (!bookingId || !sanId) {
                        await showMessage("error", "Có lỗi xảy ra", "Không tìm thấy dữ liệu đơn để check-out.");
                        return;
                    }

                    const ok = await confirmAction("Bạn muốn check-out để giải phóng sân này?");
                    if (!ok) {
                        return;
                    }

                    await submitBookingAction(checkoutBookingUrl, { bookingID: bookingId, sanID: sanId }, this, "Đã check-out và giải phóng sân.");
                });
            });

            document.querySelectorAll(".js-cancel-booking").forEach(button => {
                button.addEventListener("click", async function () {
                    const bookingId = Number(this.dataset.bookingId || 0);
                    const sanId = Number(this.dataset.sanId || 0);

                    if (!bookingId || !sanId) return;

                    const ok = await confirmAction("Bạn có chắc chắn muốn hủy đơn này? Hệ thống sẽ tự động kiểm tra mốc 60 phút để quyết định Hoàn tiền hay Mất tiền.");
                    if (!ok) return;

                    await submitBookingAction(cancelBookingUrl, { bookingID: bookingId, sanID: sanId }, this, "Xử lý hủy đơn hoàn tất!");
                });
            });

            // Edit booking handlers
            let currentDefaultPricePerHour = 0;
            let currentPriceByHour = {};
            let currentEditingBookingId = 0;
            let currentCiBookingId = 0;
            let currentCiSanId = 0;
            const getEditSanIdElement = () => document.getElementById('editSanID');
            const getEditNgayChoiElement = () => document.getElementById('editNgayChoi');
            const getSelectedHoursContainerElement = () => document.getElementById('selectedHoursContainer');
            const getEditTongTienElement = () => document.getElementById('editTongTien');

            window.openCheckInModal = function(bookingId, sanId, conLai, daThanhToan, tongTien) {
            currentCiBookingId = bookingId;
            currentCiSanId = sanId;

            if (conLai > 0) {
                document.getElementById('checkInDepositInfo').style.display = 'block';
                document.getElementById('checkInFullInfo').style.display = 'none';
                document.getElementById('ciTongTien').innerText = tongTien.toLocaleString('vi-VN') + ' đ';
                document.getElementById('ciDaCoc').innerText = daThanhToan.toLocaleString('vi-VN') + ' đ';
                document.getElementById('ciConLai').innerText = conLai.toLocaleString('vi-VN') + ' đ';
                document.getElementById('btnConfirmCheckIn').innerText = 'Đã thu tiền & Nhận sân';
            } else if (conLai < 0) {
            document.getElementById('checkInDepositInfo').style.display = 'block';
            document.getElementById('checkInFullInfo').style.display = 'none';
            document.getElementById('ciTongTien').innerText = tongTien.toLocaleString('vi-VN') + ' đ';
            document.getElementById('ciDaCoc').innerText = daThanhToan.toLocaleString('vi-VN') + ' đ';
            document.getElementById('ciConLai').innerHTML = `<span style="color: #28a745;">Cần hoàn trả khách: ${Math.abs(conLai).toLocaleString('vi-VN')} đ</span>`;
            document.getElementById('btnConfirmCheckIn').innerText = 'Đã hoàn tiền & Nhận sân';
        } else {
                document.getElementById('checkInDepositInfo').style.display = 'none';
                document.getElementById('checkInFullInfo').style.display = 'block';
                document.getElementById('btnConfirmCheckIn').innerText = 'Xác nhận Nhận sân';
            }

            var checkInModal = new bootstrap.Modal(document.getElementById('checkInModal'));
            checkInModal.show();
        };

        window.confirmCheckIn = function() {
            const btn = document.getElementById('btnConfirmCheckIn');
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = "Đang xử lý...";

            fetch('@Url.Action("CheckInCourt", "ManagerDonDatSan")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ BookingID: currentCiBookingId, SanID: currentCiSanId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('Thành công!', data.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi!', data.message || "Không thể Check-in", 'error');
                    btn.disabled = false;
                    btn.textContent = originalText;
                }
            }).catch(err => {
                Swal.fire('Lỗi!', 'Lỗi kết nối đến máy chủ.', 'error');
                btn.disabled = false;
                btn.textContent = originalText;
            });
        };

            function renderTimeSlots(selectedHours, availableSlots = null) {
                const selectedHoursContainerElement = getSelectedHoursContainerElement();
                if (!selectedHoursContainerElement) {
                    console.error("selectedHoursContainer not found");
                    return;
                }
                
                selectedHoursContainerElement.innerHTML = '';
                const slotsByHour = Array.isArray(availableSlots)
                    ? new Map(availableSlots.map(slot => [Number(slot.hour), slot]))
                    : null;
                
                // Lọc selectedHours để loại bỏ khung giờ disabled
                const validSelectedHours = selectedHours.filter(hour => {
                    const slotData = slotsByHour ? slotsByHour.get(Number(hour)) : null;
                    return !slotData || !slotData.disabled;
                });
                
                for (let hour = 5; hour <= 23; hour++) {
                    const slot = document.createElement('div');
                    const slotData = slotsByHour ? slotsByHour.get(hour) : null;
                    const isDisabled = slotData && slotData.disabled;
                    const label = slotData ? slotData.label : 'Có sẵn';
                    
                    let className = `time-slot`;
                    if (validSelectedHours.includes(hour) && !isDisabled) {
                        className += ' selected';
                    }
                    if (isDisabled) {
                        className += ' disabled';
                    }
                    
                    slot.className = className;
                    const startText = String(hour).padStart(2, '0');
                    const endText = String(hour + 1).padStart(2, '0');
                    slot.textContent = `${startText}:00 - ${endText}:00`;
                    slot.dataset.hour = hour;
                    slot.title = label;
                    
                    if (!isDisabled) {
                        slot.style.cursor = 'pointer';
                        slot.addEventListener('click', function (e) {
                            e.preventDefault();
                            this.classList.toggle('selected');
                            calculateTongTien();
                        });
                    } else {
                        slot.style.cursor = 'not-allowed';
                    }
                    
                    selectedHoursContainerElement.appendChild(slot);
                }
            }

            async function loadAvailableSlots(sanId, ngayChoi, excludeBookingId = 0) {
                if (!sanId || !ngayChoi) return null;
                
                try {
                    const url = '@Url.Action("GetAvailableTimeSlots", "ManagerDonDatSan")'
                        + '?sanId=' + sanId
                        + '&ngayChoi=' + ngayChoi
                        + '&excludeBookingId=' + (excludeBookingId || 0);
                    const response = await fetch(url);
                    if (!response.ok) return null;
                    const result = await response.json();
                    if (!result.success) return null;
                    const payload = result.data || null;
                    if (!payload) return null;
                    currentDefaultPricePerHour = Number(payload.defaultPricePerHour || 0);
                    currentPriceByHour = payload.priceByHour || {};
                    return payload.slots || null;
                } catch (error) {
                    console.error("Error loading available slots:", error);
                    return null;
                }
            }

            function calculateTongTien() {
                const editSanIdElement = getEditSanIdElement();
                const editTongTienElement = getEditTongTienElement();
                const selectedHoursContainerElement = getSelectedHoursContainerElement();
                if (!editSanIdElement || !editTongTienElement || !selectedHoursContainerElement) return;
                
                const selectedHours = Array.from(selectedHoursContainerElement.querySelectorAll('.time-slot.selected')).map(btn => Number(btn.dataset.hour));
                const tongTien = selectedHours.reduce((sum, hour) => {
                    const key = String(hour);
                    const unitPrice = Number(currentPriceByHour[key] ?? currentDefaultPricePerHour ?? 0);
                    return sum + unitPrice;
                }, 0);
                editTongTienElement.textContent = tongTien.toLocaleString('vi-VN') + ' đ';
            }

            async function reloadAvailableSlotsForEdit(resetSelection) {
                const editSanIdElement = getEditSanIdElement();
                const editNgayChoiElement = getEditNgayChoiElement();
                const selectedHoursContainerElement = getSelectedHoursContainerElement();
                const editTongTienElement = getEditTongTienElement();
                const sanId = Number(editSanIdElement?.value || 0);
                const ngayChoi = editNgayChoiElement?.value || '';
                if (!sanId || !ngayChoi || !selectedHoursContainerElement) return;

                const availableSlots = await loadAvailableSlots(sanId, ngayChoi, currentEditingBookingId);
                if (!Array.isArray(availableSlots)) {
                    selectedHoursContainerElement.innerHTML = '<p class="text-danger mb-0">Không tải được trạng thái khung giờ. Vui lòng thử lại.</p>';
                    if (editTongTienElement) {
                        editTongTienElement.textContent = '0 đ';
                    }
                    return;
                }

                const selectedHours = resetSelection
                    ? []
                    : Array.from(selectedHoursContainerElement.querySelectorAll('.time-slot.selected'))
                        .map(slot => Number(slot.dataset.hour));

                renderTimeSlots(selectedHours, availableSlots);
                calculateTongTien();
            }

            document.querySelectorAll(".js-edit-booking").forEach(button => {
                button.addEventListener("click", async function () {
                    const bookingId = Number(this.dataset.bookingId || 0);
                    
                    if (!bookingId) {
                        console.error("Invalid booking ID");
                        return;
                    }

                    try {
                        const baseUrl = "@Url.Action("GetBookingForEdit", "ManagerDonDatSan")";
                        const url = baseUrl + "?id=" + bookingId;
                        
                        const response = await fetch(url);
                        const text = await response.text();
                        
                        let result;
                        try {
                            result = JSON.parse(text);
                        } catch(e) {
                            await showMessage("error", "Lỗi", "Response không phải JSON");
                            return;
                        }
                        
                        if (!result.success) {
                            await showMessage("error", "Lỗi", result.message || "Không thể tải thông tin đơn.");
                            return;
                        }

                        const data = result.data;
                        
                        document.getElementById('editDonDatSanID').value = data.donDatSanID;
                        document.getElementById('editSanID').value = data.sanID;
                        document.getElementById('editTenKhach').value = data.tenKhachHang;
                        document.getElementById('editSoDienThoai').value = data.soDienThoai;
                        document.getElementById('editNgayChoi').value = data.ngayChoi;
                        currentDefaultPricePerHour = Number(data.pricePerHour || 0);
                        currentPriceByHour = {};
                        currentEditingBookingId = Number(data.donDatSanID || 0);

                        // Load available time slots and render
                        const availableSlots = await loadAvailableSlots(data.sanID, data.ngayChoi, currentEditingBookingId);
                        if (!Array.isArray(availableSlots)) {
                            const selectedHoursContainerElement = getSelectedHoursContainerElement();
                            const editTongTienElement = getEditTongTienElement();
                            if (selectedHoursContainerElement) {
                                selectedHoursContainerElement.innerHTML = '<p class="text-danger mb-0">Không tải được trạng thái khung giờ. Vui lòng thử lại.</p>';
                            }
                            if (editTongTienElement) {
                                editTongTienElement.textContent = '0 đ';
                            }
                        } else {
                            renderTimeSlots(data.selectedHours, availableSlots);
                            calculateTongTien();
                        }

                        const editBookingModal = document.getElementById('editBookingModal');
                        if (editBookingModal) {
                            new bootstrap.Modal(editBookingModal).show();
                        }
                    } catch (error) {
                        await showMessage("error", "Lỗi", "Exception: " + error.message);
                    }
                });
            });

            // Add event listeners to reload available slots when changing san or ngayChoi
            document.addEventListener('change', async function (e) {
                const target = e.target;
                if (!(target instanceof HTMLElement)) return;

                if (target.id === 'editSanID') {
                    await reloadAvailableSlotsForEdit(false);
                    return;
                }

                if (target.id === 'editNgayChoi') {
                    // Đổi ngày => luôn reset lại khung giờ đã chọn để bám đúng trạng thái ngày mới.
                    await reloadAvailableSlotsForEdit(true);
                }
            });

            // Sử dụng event delegation để gắn submit handler cho form
            // (Form được tạo động nên không thể querySelector trực tiếp)
            document.addEventListener('submit', async function (e) {
                // Kiểm tra xem submit event từ editBookingForm hay không
                if (e.target.id !== 'editBookingForm') return;
                
                e.preventDefault();

                // Lấy dữ liệu từ các input trong Modal
                const donDatSanIDInput = document.getElementById('editDonDatSanID');
                const sanIDInput = document.getElementById('editSanID');
                const ngayChoiInput = document.getElementById('editNgayChoi');
                const selectedHoursContainer = document.getElementById('selectedHoursContainer');
                const btnSave = document.getElementById('btnSaveUpdate');
                
                const donDatSanID = Number(donDatSanIDInput?.value || 0);
                const sanID = Number(sanIDInput?.value || 0);
                const ngayChoi = ngayChoiInput?.value || '';
                const selectedHours = Array.from(selectedHoursContainer?.querySelectorAll('.time-slot.selected:not(.disabled)') || [])
                    .map(slot => Number(slot.dataset.hour))
                    .sort((a, b) => a - b);

                // Validation
                if (!donDatSanID) {
                    await showMessage("error", "Lỗi", "Không tìm thấy mã đơn. Vui lòng thử lại.");
                    return;
                }

                if (!sanID) {
                    await showMessage("error", "Lỗi", "Vui lòng chọn sân.");
                    return;
                }

                if (!ngayChoi) {
                    await showMessage("error", "Lỗi", "Vui lòng chọn ngày chơi.");
                    return;
                }

                if (selectedHours.length === 0) {
                    await showMessage("error", "Lỗi", "Vui lòng chọn ít nhất một khung giờ có sẵn.");
                    return;
                }

                // Disable button during submission
                const originalText = btnSave?.textContent || "Cập Nhật";
                if (btnSave) {
                    btnSave.disabled = true;
                    btnSave.textContent = "Đang cập nhật...";
                }

                try {
                    const updateUrl = '@Url.Action("UpdateBooking", "ManagerDonDatSan")';
                    
                    const response = await fetch(updateUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            donDatSanID: donDatSanID,
                            sanID: sanID,
                            ngayChoi: ngayChoi,
                            selectedHours: selectedHours
                        })
                    });

                    console.log("Response status:", response.status);

                    let result;
                    try {
                        result = await response.json();
                    } catch(e) {
                        await showMessage("error", "Lỗi", "Phản hồi không hợp lệ từ máy chủ");
                        return;
                    }

                    if (result.success) {
                        await showMessage("success", "Thành công", "Đã cập nhật đơn đặt sân.");
                        
                        // Close modal
                        const editBookingModal = document.getElementById('editBookingModal');
                        if (editBookingModal) {
                            const modal = bootstrap.Modal.getInstance(editBookingModal);
                            if (modal) modal.hide();
                        }
                        
                        setTimeout(() => {
                            window.location.reload();
                        }, 500);
                    } else {
                        await showMessage("error", "Lỗi", result.message || "Không thể cập nhật đơn.");
                    }
                } catch (error) {
                    await showMessage("error", "Lỗi", "Không thể kết nối máy chủ. Vui lòng thử lại.");
                } finally {
                    if (btnSave) {
                        btnSave.disabled = false;
                        btnSave.textContent = originalText;
                    }
                }
            }, false);
        })();
                
    </script>

    <!-- Màn hình Modal Check-in -->
    <div class="modal fade" id="checkInModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Check-in Nhận Sân</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <!-- Nội dung khi khách mới Cọc 50% -->
                    <div id="checkInDepositInfo" style="display: none;">
                        <h4 class="text-danger mb-3">Khách mới thanh toán cọc!</h4>
                        <p>Tổng tiền đơn: <strong id="ciTongTien">0 đ</strong></p>
                        <p>Khách đã đặt cọc: <strong id="ciDaCoc" class="text-warning">0 đ</strong></p>
                        <hr />
                        <h5 class="text-primary mt-3">Tiền mặt cần thu thêm: <br><strong id="ciConLai" style="font-size: 1.8rem;">0 đ</strong></h5>
                    </div>
                    <!-- Nội dung khi khách đã trả 100% -->
                    <div id="checkInFullInfo" style="display: none;">
                        <h4 class="text-success mb-3"><i class="fas fa-check-circle"></i> Khách đã thanh toán 100%!</h4>
                        <p>Không cần thu thêm tiền. Bấm xác nhận để đổi trạng thái sang Đang chơi.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmCheckIn" onclick="confirmCheckIn()">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Booking Modal -->
    <div class="modal fade" id="editBookingModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sửa Đơn Đặt Sân</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="editBookingForm" novalidate>
                    <div class="modal-body">
                        <input type="hidden" id="editDonDatSanID" name="editDonDatSanID" required>

                        <div class="mb-3">
                            <label class="form-label">Tên Khách Hàng <span class="text-muted">(Không sửa được)</span></label>
                            <input type="text" id="editTenKhach" class="form-control" disabled>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Số Điện Thoại <span class="text-muted">(Không sửa được)</span></label>
                            <input type="text" id="editSoDienThoai" class="form-control" disabled>
                        </div>

                        <div class="mb-3">
                            <label for="editSanID" class="form-label">Chọn Sân <span class="text-danger">*</span></label>
                            <select id="editSanID" name="editSanID" class="form-select" required>
                                <option value="">-- Chọn sân --</option>
                                @{
                                    var sanOptions = ViewBag.SanOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
                                    @foreach (var san in sanOptions)
                                    {
                                        <option value="@san.Value">@san.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="editNgayChoi" class="form-label">Ngày Chơi <span class="text-danger">*</span></label>
                            <input type="date" id="editNgayChoi" name="editNgayChoi" class="form-control" required min="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Chọn Khung Giờ <span class="text-danger">*</span></label>
                            <div id="selectedHoursContainer" class="time-slots-grid">
                                <p class="text-muted">Đang tải khung giờ...</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tổng Tiền</label>
                            <div id="editTongTien" class="form-control" style="background: #f8f9fa; cursor: not-allowed; color: #333; font-weight: 500;">0 đ</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="btnSaveUpdate" class="btn btn-primary">
                            <span class="btn-text">Cập Nhật</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="invoiceModal" class="booking-overlay" hidden>
    <div class="booking-overlay-backdrop js-close-invoice"></div>
    <div class="booking-modal invoice-preview-modal" style="max-width: 500px; padding: 25px;">
        <button type="button" class="booking-close js-close-invoice" style="border: none; background: transparent; font-size: 24px; cursor: pointer; float: right;">×</button>
        <h3 class="text-center mb-4" style="color: var(--manager-green-800);">HÓA ĐƠN THANH TOÁN</h3>
        
        <div class="invoice-content" style="background: #f8f9fa; padding: 15px; border-radius: 8px;">
            <div class="d-flex justify-content-between mb-2"><span>Mã hóa đơn:</span> <strong id="invId"></strong></div>
            <div class="d-flex justify-content-between mb-2"><span>Khách hàng:</span> <strong id="invCustomer"></strong></div>
            <div class="d-flex justify-content-between mb-2"><span>Sân:</span> <strong id="invCourt"></strong></div>
            <div class="d-flex justify-content-between mb-2"><span>Khung giờ:</span> <strong id="invTime"></strong></div>
            <hr>
            <div class="d-flex justify-content-between mb-2"><span>Tổng tiền:</span> <strong id="invTotal"></strong></div>
            <div class="d-flex justify-content-between mb-2"><span>Giảm giá:</span> <strong id="invDiscount"></strong></div>
            <div class="d-flex justify-content-between mt-3">
                <h5 style="margin:0;">Thành tiền:</h5> <h5 style="color: var(--manager-green-700); margin:0;" id="invFinal"></h5>
            </div>
        </div>

        <div class="modal-footer mt-4 d-flex justify-content-center" style="border-top: none;">
            <a href="#" id="btnPrintInvoice" class="btn btn-primary" style="background-color: var(--manager-green-700); border: none; padding: 10px 20px;">
                <i class="fas fa-print"></i> Tải / In PDF
            </a>
        </div>
    </div>
</div>


    <style>
        .time-slots-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .time-slot {
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: #fff;
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
            user-select: none;
        }

        .time-slot:hover {
            border-color: #0d6efd;
            background: #f0f7ff;
        }

        .time-slot.selected {
            background: #0d6efd;
            color: white;
            border-color: #0d6efd;
        }

        .time-slot.disabled {
            background: repeating-linear-gradient(
                135deg,
                #e9ecef 0px,
                #e9ecef 10px,
                #dee2e6 10px,
                #dee2e6 14px
            ) !important;
            color: #6c757d !important;
            border-color: #dee2e6 !important;
            cursor: not-allowed;
            opacity: 0.9;
            text-decoration: line-through;
            text-decoration-thickness: 2px;
            text-decoration-color: rgba(108, 117, 125, 0.95);
            pointer-events: none;
        }

        .time-slot.disabled.selected {
            background: repeating-linear-gradient(
                135deg,
                #e9ecef 0px,
                #e9ecef 10px,
                #dee2e6 10px,
                #dee2e6 14px
            ) !important;
            color: #6c757d !important;
            border-color: #dee2e6 !important;
        }

        .time-slot.disabled:hover {
            background: repeating-linear-gradient(
                135deg,
                #e9ecef 0px,
                #e9ecef 10px,
                #dee2e6 10px,
                #dee2e6 14px
            ) !important;
            border-color: #dee2e6 !important;
        }
    </style>
}
