@{
    Layout = null;
    ViewData["Title"] = "Admin Login";
    var error = TempData["Error"]?.ToString();
    var returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #1f3f8f, #4e73df);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1f2937;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            padding: 28px;
            box-sizing: border-box;
        }

        .login-title {
            margin: 0 0 6px;
            font-size: 24px;
            color: #1f3f8f;
        }

        .login-subtitle {
            margin: 0 0 20px;
            color: #6b7280;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
            font-weight: 700;
        }

        .form-group input {
            width: 100%;
            height: 42px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 0 12px;
            box-sizing: border-box;
            font-size: 14px;
        }

        .error-box {
            margin-bottom: 14px;
            padding: 10px 12px;
            border-radius: 8px;
            background: #fef2f2;
            color: #b91c1c;
            font-size: 14px;
            border: 1px solid #fecaca;
        }

        .btn-submit {
            width: 100%;
            height: 44px;
            border: 0;
            border-radius: 8px;
            background: #1f3f8f;
            color: #fff;
            font-weight: 700;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h1 class="login-title">Admin Portal</h1>
        <p class="login-subtitle">Đăng nhập quản trị tại đường dẫn `/wp-admin`.</p>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="error-box">@error</div>
        }

        <form method="post" action="/wp-admin">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="form-group">
                <label for="username">Tên đăng nhập / Email / SĐT</label>
                <input type="text" id="username" name="username" required autocomplete="username" />
            </div>

            <div class="form-group">
                <label for="password">Mật khẩu</label>
                <input type="password" id="password" name="password" required autocomplete="current-password" />
            </div>

            <button type="submit" class="btn-submit">Đăng nhập Admin</button>
        </form>
    </div>
</body>
</html>
