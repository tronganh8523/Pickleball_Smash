@model IEnumerable<Pickleball_Smash.Models.NguoiDung>

@{
    ViewData["Title"] = "Quản Lý Tài Khoản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h3 mb-0 text-dark"><i class="fas fa-users"></i> Danh Sách Tài Khoản</h1>
        </div>
        <div class="col-md-4 text-right">
            <a asp-controller="AdminUser" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm Tài Khoản Mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tên Đăng Nhập</th>
                            <th>Họ Tên</th>
                            <th>Email</th>
                            <th>SĐT</th>
                            <th>Vai Trò</th>
                            <th>Ngày Tạo</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NguoiDungID</td>
                                    <td>@item.TenDangNhap</td>
                                    <td>@item.HoTen</td>
                                    <td>@item.Email</td>
                                    <td>@item.SDT</td>
                                    <td>
                                        <span class="badge @(item.VaiTro == "Admin" ? "bg-danger" : item.VaiTro == "Manager" ? "bg-warning text-dark" : "bg-info")">
                                            @item.VaiTro
                                        </span>
                                    </td>
                                    <td>@item.NgayTao?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <a asp-controller="AdminUser" asp-action="Edit" asp-route-id="@item.NguoiDungID" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                                        <a asp-controller="AdminUser" asp-action="Delete" asp-route-id="@item.NguoiDungID" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">Chưa có tài khoản nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
