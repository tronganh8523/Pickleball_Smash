@model Pickleball_Smash.Models.NguoiDung

@{
    ViewData["Title"] = "Xóa Tài Khoản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="h3 mb-4 text-dark">Xóa Tài Khoản</h1>
            <div class="card shadow border-danger mb-4">
                <div class="card-header bg-danger text-white"><h6 class="m-0">Xác Nhận Xóa</h6></div>
                <div class="card-body">
                    <p>Bạn có chắc muốn xóa tài khoản <strong>@Model.TenDangNhap</strong>?</p>
                    <ul class="mb-3">
                        <li>Họ tên: @Model.HoTen</li>
                        <li>Email: @Model.Email</li>
                        <li>Vai trò: @Model.VaiTro</li>
                    </ul>
                    <form asp-controller="AdminUser" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="NguoiDungID" />
                        <button type="submit" class="btn btn-danger">Xóa</button>
                        <a asp-controller="AdminUser" asp-action="Index" class="btn btn-secondary">Hủy</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
