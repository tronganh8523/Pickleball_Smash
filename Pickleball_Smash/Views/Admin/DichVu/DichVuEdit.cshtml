@model Pickleball_Smash.Models.DichVuPhuTro

@{
    ViewData["Title"] = "Chỉnh Sửa Dịch Vụ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="h3 mb-4 text-dark">Chỉnh Sửa Dịch Vụ</h1>
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white"><h6 class="m-0">Thông Tin Dịch Vụ</h6></div>
                <div class="card-body">
                    <form asp-controller="AdminDichVu" asp-action="Edit" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="DichVuID" />

                        <div class="mb-3">
                            <label asp-for="TenDichVu" class="form-label">Tên Dịch Vụ</label>
                            <input asp-for="TenDichVu" class="form-control" />
                            <span asp-validation-for="TenDichVu" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LoaiDichVu" class="form-label">Loại Dịch Vụ</label>
                            <select asp-for="LoaiDichVu" class="form-select">
                                <option value="">-- chọn --</option>
                                <option value="Đồ uống">Đồ uống</option>
                            </select>
                            <span asp-validation-for="LoaiDichVu" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Gia" class="form-label">Giá (VNĐ)</label>
                            <input asp-for="Gia" class="form-control" type="number" step="1000" min="0" value="@Model.Gia?.ToString("F0")" />
                            <span asp-validation-for="Gia" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">Lưu</button>
                            <a asp-controller="AdminDichVu" asp-action="Index" class="btn btn-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
