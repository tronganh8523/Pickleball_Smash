@model IEnumerable<Pickleball_Smash.Models.BangGiaKhungGio>

@{
    ViewData["Title"] = "Quản Lý Bảng Giá Khung Giờ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h3 mb-0 text-dark"><i class="fas fa-clock"></i> Bảng Giá Khung Giờ</h1>
        </div>
        <div class="col-md-4 text-right">
            <a asp-controller="AdminBangGiaKhungGio" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm Bảng Giá
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Sân</th>
                            <th>Giờ Bắt Đầu</th>
                            <th>Giờ Kết Thúc</th>
                            <th>Giá Tiền</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(item.SanPickleball?.TenSan ?? "-")</td>
                                    <td>@(item.GioBatDau?.ToString("HH\\:mm") ?? "-")</td>
                                    <td>@(item.GioKetThuc?.ToString("HH\\:mm") ?? "-")</td>
                                    <td>@(item.GiaTien?.ToString("N0") ?? "0") VNĐ</td>
                                    <td>
                                        <a asp-controller="AdminBangGiaKhungGio" asp-action="Edit" asp-route-id="@item.MaGia" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                                        <a asp-controller="AdminBangGiaKhungGio" asp-action="Delete" asp-route-id="@item.MaGia" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Chưa có bảng giá khung giờ.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>