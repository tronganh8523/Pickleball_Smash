<div class="modal fade" id="editVoucherModal" tabindex="-1" aria-labelledby="editVoucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editVoucherModalLabel">Chỉnh Sửa Voucher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="AdminVoucher" asp-action="Edit" method="post" data-swal-skip="true" id="editVoucherForm">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editVoucherIdParam" />
                    <input type="hidden" name="VoucherID" id="editVoucherID" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Mã Voucher</label>
                            <input name="MaVoucher" id="editMaVoucher" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Loại Giảm Giá</label>
                            <select name="LoaiGiamGia" id="editLoaiGiamGia" class="form-select js-loai-giam-gia" required>
                                <option value="">-- chọn --</option>
                                <option value="%">%</option>
                                <option value="VNĐ">VNĐ</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Giá Trị Giảm</label>
                            <input name="GiaTriGiam" id="editGiaTriGiam" class="form-control js-gia-tri-giam" type="number" step="0.01" min="0.01" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Giảm Tối Đa</label>
                            <input name="GiamToiDa" id="editGiamToiDa" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Giá Trị Đơn Tối Thiểu</label>
                            <input name="GiaTriDonToiThieu" id="editGiaTriDonToiThieu" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Số Lượng Tối Đa</label>
                            <input name="SoLuongToiDa" id="editSoLuongToiDa" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ngày Bắt Đầu</label>
                            <input name="NgayBatDau" id="editNgayBatDau" class="form-control" type="datetime-local" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ngày Kết Thúc</label>
                            <input name="NgayKetThuc" id="editNgayKetThuc" class="form-control" type="datetime-local" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Số Lượng Đã Dùng</label>
                            <input name="SoLuongDaDung" id="editSoLuongDaDung" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Mô Tả</label>
                            <input name="MoTa" id="editMoTaVoucher" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Trạng Thái</label>
                            <input name="TrangThai" id="editTrangThaiVoucher" class="form-control" readonly />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
