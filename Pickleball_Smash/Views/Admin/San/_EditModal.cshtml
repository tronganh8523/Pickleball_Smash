<div class="modal fade" id="editSanModal" tabindex="-1" aria-labelledby="editSanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editSanModalLabel">Chỉnh Sửa Sân Pickleball</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="AdminSan" asp-action="Edit" method="post" data-swal-skip="true">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editIdParam" />
                    <input type="hidden" name="SanID" id="editSanID" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên Sân</label>
                            <input name="TenSan" id="editTenSan" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Loại Sân</label>
                            <select name="LoaiSan" id="editLoaiSan" class="form-select">
                                <option value="">-- chọn --</option>
                                <option value="Trong nhà">Trong nhà</option>
                                <option value="Ngoài trời">Ngoài trời</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Giá Cơ Bản</label>
                            <input name="GiaCoBan" id="editGiaCoBan" class="form-control" type="number" step="0.01" min="0" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Trạng Thái</label>
                            <select name="TrangThai" id="editTrangThai" class="form-select">
                                <option value="Trống">Trống</option>
                                <option value="Bận">Bận</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Mô Tả</label>
                            <textarea name="MoTa" id="editMoTa" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
