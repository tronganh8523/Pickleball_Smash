@model Pickleball_Smash.Models.HinhAnhSan

@{
    ViewData["Title"] = "Xóa Ảnh Sân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="h3 mb-4 text-dark">Xóa Ảnh Sân</h1>
            <div class="card shadow mb-4 border-left-danger">
                <div class="card-body">
                    <p class="mb-3">Bạn có chắc chắn muốn xóa ảnh này không?</p>

                    @if (!string.IsNullOrWhiteSpace(Model.DuongDanURL))
                    {
                        <div class="mb-3">
                            <img src="@Model.DuongDanURL" alt="Ảnh sân" style="width: 260px; max-width: 100%; border-radius: 8px;" />
                        </div>
                        <div class="mb-3">
                            <a href="@Model.DuongDanURL" target="_blank" rel="noopener noreferrer">@Model.DuongDanURL</a>
                        </div>
                    }

                    <form asp-controller="AdminHinhAnhSan" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="HinhAnhID" />
                        <button type="submit" class="btn btn-danger">Xóa</button>
                        <a asp-controller="AdminHinhAnhSan" asp-action="Index" asp-route-sanId="@Model.SanID" class="btn btn-secondary">Hủy</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
