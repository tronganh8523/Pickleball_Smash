@model IEnumerable<Pickleball_Smash.Models.HinhAnhSan>

@{
    ViewData["Title"] = "Quản Lý Ảnh Sân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="h3 mb-0 text-dark">Quản Lý Ảnh - @ViewBag.TenSan</h1>
        </div>
        <div class="col-md-4 text-right">
            <a asp-controller="AdminHinhAnhSan" asp-action="Create" asp-route-sanId="@ViewBag.SanId" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm Ảnh
            </a>
            <a asp-controller="AdminSan" asp-action="Index" class="btn btn-secondary">Quay Lại</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-muted">Sân này chưa có ảnh.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th style="width: 120px;">Ảnh</th>
                                <th>Đường Dẫn</th>
                                <th style="width: 140px;">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@item.DuongDanURL" alt="Ảnh sân" style="width: 100px; height: 70px; object-fit: cover; border-radius: 6px;" />
                                    </td>
                                    <td>
                                        <a href="@item.DuongDanURL" target="_blank" rel="noopener noreferrer">@item.DuongDanURL</a>
                                    </td>
                                    <td>
                                        <a asp-controller="AdminHinhAnhSan" asp-action="Edit" asp-route-id="@item.HinhAnhID" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                                        <a asp-controller="AdminHinhAnhSan" asp-action="Delete" asp-route-id="@item.HinhAnhID" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
