<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pickleball Smash Manager</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/layouts/manager-layout.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    }

    <div class="manager-shell">
        <aside class="manager-sidebar" id="managerSidebar">
            <div class="brand-wrap">
                <img class="brand-logo" src="~/Img/logoReal.png" alt="Pickleball Smash" />
                <div>
                    <p class="brand-title">Pickleball Smash</p>
                    <p class="brand-subtitle">Manager Panel</p>
                </div>
            </div>

            <div class="manager-profile">
                <img src="~/Img/avatar-shin-cute-8.jpg" alt="Manager" />
                <div>
                    <h6>Hello!</h6>
                    <p>Xin chào quản lý</p>
                </div>
            </div>

            <nav class="manager-menu">
                <a class="menu-item @(currentController == "Manager" && currentAction == "Dashboard" ? "active" : "")" href="@Url.Action("Dashboard", "Manager")">
                    <i class="fas fa-house"></i>
                    Trang Chủ
                </a>
                <a class="menu-item @(currentController == "Manager" && currentAction == "Bookings" ? "active" : "")" href="@Url.Action("Bookings", "Manager")">
                    <i class="fas fa-calendar-check"></i>
                    Danh sách đặt sân
                </a>
                <a class="menu-item @(currentController == "Manager" && currentAction == "History" ? "active" : "")" href="@Url.Action("History", "Manager")">
                    <i class="fas fa-clock-rotate-left"></i>
                    Lịch sử
                </a>
                <a class="menu-item @(currentController == "Manager" && currentAction == "Profile" ? "active" : "")" href="@Url.Action("Profile", "Manager")">
                    <i class="fas fa-user-gear"></i>
                    Cập nhật thông tin cá nhân
                </a>
            </nav>

            <div class="sidebar-footer">
                <a href="@Url.Action("Dashboard", "Admin")" class="footer-link">
                    <i class="fas fa-arrow-right-arrow-left"></i>
                    Qua Admin
                </a>
                <a href="@Url.Action("Index", "Home")" class="footer-link">
                    <i class="fas fa-globe"></i>
                    Website
                </a>
            </div>
        </aside>

        <main class="manager-main">
            <header class="manager-topbar">
                <button id="menuToggle" class="menu-toggle" type="button">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm kiếm sân hoặc mã đơn..." />
                </div>
                <a href="@Url.Action("Bookings", "Manager")" class="topbar-btn">Tạo mới</a>
            </header>

            <section class="manager-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.getElementById("managerSidebar");

            if (menuToggle && sidebar) {
                menuToggle.addEventListener("click", function () {
                    sidebar.classList.toggle("show");
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
