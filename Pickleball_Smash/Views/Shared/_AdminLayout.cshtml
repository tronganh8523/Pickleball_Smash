<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pickleball Smash Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true">
    @RenderSection("Styles", required: false)
    </head>
    <body>
        @{
            var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
            var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        }

        <div class="admin-wrapper">
            <nav id="sidebar">
                <div class="sidebar-header">
                    <h5 class="mb-0 fw-bold text-white d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                             fill="currentColor" class="me-2">
                            <path
                            d="M15.5 2H8.5C6.57 2 5 3.57 5 5.5V13.5C5 15.43 6.57 17 8.5 17H10V22H14V17H15.5C17.43 17 19 15.43 19 13.5V5.5C19 3.57 17.43 2 15.5 2ZM17 13.5C17 14.33 16.33 15 15.5 15H8.5C7.67 15 7 14.33 7 13.5V5.5C7 4.67 7.67 4 8.5 4H15.5C16.33 4 17 4.67 17 5.5V13.5Z" />
                        </svg>
                        Admin Dashboard
                    </h5>
                </div>

                <div class="sidebar-content">
                    <h6 class="sidebar-heading">Bảng điều khiển</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")"
                                   href="@Url.Action("Dashboard", "Admin")">
                                <i class="fas fa-chart-line"></i> Thống Kê Chung
                            </a>
                        </li>
                    </ul>

                    <h6 class="sidebar-heading">Quản lý</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "AdminSan" ? "active" : "")"
                                   href="@Url.Action("Index", "AdminSan")">
                                <i class="fas fa-th-large"></i> Sân
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "AdminBangGiaKhungGio" ? "active" : "")"
                                   href="@Url.Action("Index", "AdminBangGiaKhungGio")">
                                <i class="fas fa-clock"></i> Bảng Giá Khung Giờ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "AdminVoucher" ? "active" : "")"
                                   href="@Url.Action("Index", "AdminVoucher")">
                                <i class="fas fa-ticket-alt"></i> Voucher
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "AdminDonDatSan" ? "active" : "")"
                                   href="@Url.Action("Index", "AdminDonDatSan")">
                                <i class="fas fa-file-invoice"></i> Đơn Đặt Sân
                            </a>
                        </li>
                    </ul>

                    <h6 class="sidebar-heading">Quản trị viên</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "AdminUser" ? "active" : "")" href="@Url.Action("Index", "AdminUser")">
                                <i class="fas fa-users-cog"></i> Quản Lý Tài Khoản
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <div id="content">
                <header class="topbar d-flex justify-content-between align-items-center">
                    <button type="button" id="sidebarCollapse" class="btn btn-link d-md-none text-dark">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h4 class="h5 mb-0 text-gray-800 d-none d-sm-block ps-3">Pickleball Smash</h4>

                    <div class="user-info pe-3">
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-600" href="#" data-bs-toggle="dropdown">
                                <img class="rounded-circle border"
                                     src="https://ui-avatars.com/api/?name=Admin&background=4e73df&color=fff" width="35"
                                     height="35">
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><button type="button" class="dropdown-item" id="openProfileModalBtn"><i class="fas fa-user me-2"></i>Thông tin cá nhân</button></li>
                                <li><button type="button" class="dropdown-item" id="openChangePasswordModalBtn"><i class="fas fa-key me-2"></i>Đổi mật khẩu</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/wp-admin/logout" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-right-from-bracket me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <main class="container-fluid p-4">
                    @RenderBody()
                </main>

                <form id="adminAntiForgeryForm" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>

        <div class="modal fade" id="adminProfileModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Thông tin cá nhân</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Họ tên</label>
                            <input type="text" class="form-control" id="adminProfileFullName">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" id="adminProfileEmail">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input type="text" class="form-control" id="adminProfilePhone">
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Giới tính</label>
                            <select class="form-select" id="adminProfileGender">
                                <option value="">Chưa chọn</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="saveAdminProfileBtn">Lưu thay đổi</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="adminChangePasswordModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Đổi mật khẩu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu cũ</label>
                            <input type="password" class="form-control" id="adminOldPassword">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <input type="password" class="form-control" id="adminNewPassword">
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Nhập lại mật khẩu mới</label>
                            <input type="password" class="form-control" id="adminConfirmPassword">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="saveAdminPasswordBtn">Cập nhật mật khẩu</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
            $('#sidebar').toggleClass('active');
            });
            });

            document.addEventListener("DOMContentLoaded", function () {
                if (typeof Swal === "undefined") {
                    return;
                }

                // Convert TempData bootstrap alerts to SweetAlert2 popups.
                const flashAlerts = document.querySelectorAll(".alert.alert-success, .alert.alert-danger, .alert.alert-warning, .alert.alert-info");
                flashAlerts.forEach(function (alertEl) {
                    if (alertEl.hasAttribute("data-valmsg-summary")) {
                        return;
                    }

                    const text = (alertEl.textContent || "").trim();
                    if (!text) {
                        return;
                    }

                    let icon = "info";
                    if (alertEl.classList.contains("alert-success")) {
                        icon = "success";
                    } else if (alertEl.classList.contains("alert-danger")) {
                        icon = "error";
                    } else if (alertEl.classList.contains("alert-warning")) {
                        icon = "warning";
                    }

                    Swal.fire({
                        icon: icon,
                        text: text,
                        confirmButtonText: "OK"
                    });

                    alertEl.remove();
                });

                // Use SweetAlert2 confirmation on Admin CRUD form submits.
                document.addEventListener("submit", function (event) {
                    const form = event.target;
                    if (!form || form.dataset.swalConfirmed === "true") {
                        return;
                    }

                    if (form.dataset.swalSkip === "true") {
                        return;
                    }

                    const method = (form.getAttribute("method") || "").toLowerCase();
                    const action = (form.getAttribute("action") || "").toLowerCase();
                    if (method !== "post") {
                        return;
                    }

                    const submitter = event.submitter;
                    if (!submitter) {
                        return;
                    }

                    const text = (submitter.textContent || "").trim().toLowerCase();
                    let operation = "save";
                    if (action.includes("/delete") || submitter.classList.contains("btn-danger") || text.includes("xóa")) {
                        operation = "delete";
                    } else if (action.includes("/create") || text.includes("thêm") || text.includes("tạo")) {
                        operation = "create";
                    } else if (action.includes("/edit") || action.includes("/update") || text.includes("lưu") || text.includes("cập nhật")) {
                        operation = "update";
                    }

                    if (operation === "save") {
                        return;
                    }

                    event.preventDefault();

                    let icon = "question";
                    let title = "Xác nhận thao tác";
                    let message = "Bạn có chắc chắn muốn thực hiện thao tác này không?";
                    let confirmText = "Đồng ý";

                    if (operation === "create") {
                        title = "Xác nhận tạo mới";
                        message = "Bạn có muốn tạo dữ liệu mới không?";
                        confirmText = "Tạo mới";
                    } else if (operation === "update") {
                        title = "Xác nhận cập nhật";
                        message = "Bạn có muốn lưu thay đổi này không?";
                        confirmText = "Cập nhật";
                    } else if (operation === "delete") {
                        icon = "warning";
                        title = "Xác nhận xóa";
                        message = "Bạn có chắc chắn muốn xóa dữ liệu này không?";
                        confirmText = "Xóa";
                    }

                    Swal.fire({
                        icon: icon,
                        title: title,
                        text: message,
                        showCancelButton: true,
                        confirmButtonText: confirmText,
                        cancelButtonText: "Hủy"
                    }).then(function (result) {
                        if (!result.isConfirmed) {
                            return;
                        }

                        form.dataset.swalConfirmed = "true";
                        if (typeof form.requestSubmit === "function") {
                            form.requestSubmit(submitter);
                        } else {
                            form.submit();
                        }
                    });
                }, true);

                // Use SweetAlert2 when clicking delete links in list/table pages.
                document.addEventListener("click", function (event) {
                    const anchor = event.target.closest("a.btn-danger");
                    if (!anchor) {
                        return;
                    }

                    const href = (anchor.getAttribute("href") || "").toLowerCase();
                    if (!href.includes("/delete")) {
                        return;
                    }

                    event.preventDefault();

                    Swal.fire({
                        icon: "warning",
                        title: "Xác nhận xóa",
                        text: "Bạn có chắc chắn muốn xóa dữ liệu này không?",
                        showCancelButton: true,
                        confirmButtonText: "Xóa",
                        cancelButtonText: "Hủy"
                    }).then(function (result) {
                        if (!result.isConfirmed) {
                            return;
                        }

                        const tokenInput = document.querySelector('#adminAntiForgeryForm input[name="__RequestVerificationToken"]');
                        const token = tokenInput ? tokenInput.value : "";

                        const form = document.createElement("form");
                        form.method = "post";
                        form.action = anchor.href;
                        form.style.display = "none";
                        form.dataset.swalConfirmed = "true";

                        if (token) {
                            const hiddenToken = document.createElement("input");
                            hiddenToken.type = "hidden";
                            hiddenToken.name = "__RequestVerificationToken";
                            hiddenToken.value = token;
                            form.appendChild(hiddenToken);
                        }

                        document.body.appendChild(form);
                        form.submit();
                    });
                });

                const profileModalEl = document.getElementById("adminProfileModal");
                const changePasswordModalEl = document.getElementById("adminChangePasswordModal");
                const openProfileBtn = document.getElementById("openProfileModalBtn");
                const openPasswordBtn = document.getElementById("openChangePasswordModalBtn");
                const saveProfileBtn = document.getElementById("saveAdminProfileBtn");
                const savePasswordBtn = document.getElementById("saveAdminPasswordBtn");

                const profileModal = profileModalEl ? new bootstrap.Modal(profileModalEl) : null;
                const passwordModal = changePasswordModalEl ? new bootstrap.Modal(changePasswordModalEl) : null;

                if (openProfileBtn && profileModal) {
                    openProfileBtn.addEventListener("click", async function () {
                        try {
                            const res = await fetch('@Url.Action("MyProfile", "AdminUser")');
                            const result = await res.json();
                            if (!res.ok || !result?.success) {
                                Swal.fire({ icon: "error", text: result?.message || "Không tải được thông tin cá nhân." });
                                return;
                            }
                            document.getElementById("adminProfileFullName").value = result.data?.hoTen || "";
                            document.getElementById("adminProfileEmail").value = result.data?.email || "";
                            document.getElementById("adminProfilePhone").value = result.data?.sdt || "";
                            document.getElementById("adminProfileGender").value = result.data?.gioiTinh || "";
                            profileModal.show();
                        } catch {
                            Swal.fire({ icon: "error", text: "Lỗi kết nối máy chủ." });
                        }
                    });
                }

                if (saveProfileBtn && profileModal) {
                    saveProfileBtn.addEventListener("click", async function () {
                        const payload = {
                            fullName: document.getElementById("adminProfileFullName").value.trim(),
                            email: document.getElementById("adminProfileEmail").value.trim(),
                            phone: document.getElementById("adminProfilePhone").value.trim(),
                            gender: document.getElementById("adminProfileGender").value
                        };

                        try {
                            const res = await fetch('@Url.Action("UpdateMyProfile", "AdminUser")', {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(payload)
                            });
                            const result = await res.json();
                            if (!res.ok || !result?.success) {
                                Swal.fire({ icon: "error", text: result?.message || "Không thể cập nhật thông tin." });
                                return;
                            }
                            Swal.fire({ icon: "success", text: result.message || "Cập nhật thành công." });
                            profileModal.hide();
                        } catch {
                            Swal.fire({ icon: "error", text: "Lỗi kết nối máy chủ." });
                        }
                    });
                }

                if (openPasswordBtn && passwordModal) {
                    openPasswordBtn.addEventListener("click", function () {
                        document.getElementById("adminOldPassword").value = "";
                        document.getElementById("adminNewPassword").value = "";
                        document.getElementById("adminConfirmPassword").value = "";
                        passwordModal.show();
                    });
                }

                if (savePasswordBtn && passwordModal) {
                    savePasswordBtn.addEventListener("click", async function () {
                        const oldPassword = document.getElementById("adminOldPassword").value;
                        const newPassword = document.getElementById("adminNewPassword").value;
                        const confirmPassword = document.getElementById("adminConfirmPassword").value;

                        if (!oldPassword || !newPassword || !confirmPassword) {
                            Swal.fire({ icon: "warning", text: "Vui lòng nhập đầy đủ mật khẩu cũ, mới và xác nhận mật khẩu." });
                            return;
                        }

                        if (newPassword !== confirmPassword) {
                            Swal.fire({ icon: "warning", text: "Mật khẩu xác nhận không khớp." });
                            return;
                        }

                        const payload = {
                            oldPassword: oldPassword,
                            newPassword: newPassword,
                            confirmPassword: confirmPassword
                        };
                        try {
                            const res = await fetch('@Url.Action("ChangeMyPassword", "AdminUser")', {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(payload)
                            });
                            const result = await res.json();
                            if (!res.ok || !result?.success) {
                                Swal.fire({ icon: "error", text: result?.message || "Không thể đổi mật khẩu." });
                                return;
                            }
                            Swal.fire({ icon: "success", text: result.message || "Đổi mật khẩu thành công." });
                            passwordModal.hide();
                        } catch {
                            Swal.fire({ icon: "error", text: "Lỗi kết nối máy chủ." });
                        }
                    });
                }
            });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>