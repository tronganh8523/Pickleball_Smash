@{
    // Lấy tên nhân viên từ Session để hiển thị
    var hoTen = Context.Session.GetString("HoTen") ?? "Nhân viên";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pickleball Smash</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    
    <link rel="stylesheet" href="~/css/layouts/manager-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staff-dashboard.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="manager-shell">
        
        <nav class="manager-sidebar">
            <aside class="manager-sidebar" id="managerSidebar">
                <div class="brand-wrap">
                    <img class="brand-logo" src="~/Img/logoReal.png" alt="Pickleball Smash" />
                    <div>
                        <p class="brand-title">Pickleball Smash</p>
                        <p class="brand-subtitle">Staff Panel</p>
                    </div>
                </div>
                <div class="manager-profile">
                    <img src="~/Img/avatar-shin-cute-8.jpg" alt="Manager" />
                    <div>
                        <h6>Hello!</h6>
                        <p>Xin chào nhân viên</p>
                    </div>
                </div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/Staff" class="sidebar-link active">
                        <i class="fas fa-chart-pie"></i> Trang chủ
                    </a>
                </li>
                <li>
                    <a href="#" class="sidebar-link">
                        <i class="fas fa-calendar-check"></i> Đặt sân
                    </a>
                </li>
                <li>
                    <a href="#" class="sidebar-link">
                        <i class="fas fa-history"></i> Lịch sử
                    </a>
                </li>
                <li>
                    <a href="#" class="sidebar-link">
                        <i class="fas fa-user-circle"></i> Cá nhân
                    </a>
                </li>
            </ul>

            <div class="sidebar-bottom">
                <a href="#" class="sidebar-link" style="color: #ffb3b3;">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </div>
        </nav>

        <main class="manager-content">
            
            @RenderBody()

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>