@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userId = Context.Session.GetInt32("UserID");
    var hoTen = Context.Session.GetString("HoTen");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pickleball Smash</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/customer-style.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="customer-header">
        <div class="header-container">
            <a asp-controller="Home" asp-action="Index" class="header-logo">
                <img src="~/Img/logoReal.png" alt="Pickleball Smash" />
            </a>

            <ul class="header-nav">
                <li><a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")">Trang chủ</a></li>
                <li><a asp-controller="San" asp-action="Index" class="@(currentController == "San" ? "active" : "")">Danh sách sân</a></li>
                <li><a href="#footer-info">Liên hệ</a></li>
            </ul>

            <div class="header-search">
                <form asp-controller="San" asp-action="Index" method="get">
                    <input type="text" name="searchQuery" placeholder="Tìm kiếm sân..." autocomplete="off" />
                    <button type="submit"><i class="fas fa-search"></i></button>
                </form>
            </div>

            @if (userId != null)
            {
                <div class="header-user-menu">
                    <div class="user-dropdown">
                        Lịch Sử <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="user-dropdown" onclick="openProfileModal()">
                        Tài Khoản
                    </div>
                    <div class="user-avatar-wrap">
                        <img src="~/Img/avatar-shin-cute-8.jpg" alt="Avatar" class="user-avatar" onclick="openProfileModal()" />
                        <a href="/Account/Logout" class="btn-logout">Thoát</a>
                    </div>
                </div>
            }
            else
            {
                <div class="header-auth">
                    <button class="btn-outline" onclick="openAuthModal('login')">Đăng nhập</button>
                    <button class="btn-solid" onclick="openAuthModal('register')">Đăng ký</button>
                </div>
            }
        </div>
    </header>
    <section class="page-banner">
        <div class="page-banner-bg"></div>
        <div class="banner-content">
            <h1>PICKLEBALL SMASH</h1>
            <div class="breadcrumb">
                <span>Sân chơi mới</span> / <span class="active-page">Đẳng cấp mới</span>
            </div>
        </div>
        <img src="~/Img/Img_banner.png" alt="Pickleball Player" class="banner-image-overlay" />
    </section>

    <main>
        @RenderBody()
    </main>

    <footer id="footer-info" class="customer-footer">
        <div class="footer-container">
            <div class="footer-col">
                <h4>THÔNG TIN LIÊN HỆ</h4>
                <p>Nội dung liên hệ sẽ được cập nhật sau...</p>
            </div>
            <div class="footer-logo">
                <img src="~/Img/logoReal.png" alt="Logo Footer" />
            </div>
            <div class="footer-col">
                <h4>CHÍNH SÁCH</h4>
                <p>Nội dung chính sách sẽ được cập nhật sau...</p>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; @DateTime.Now.Year Pickleball Smash. All rights reserved.
        </div>
    </footer>
    <div id="bookingModal" class="auth-modal-overlay">
        <div class="auth-modal modal-xl">
            <button class="auth-close" onclick="closeModal('bookingModal')">×</button>
            <h2 class="auth-title" style="text-align: left; margin-bottom: 25px;">Đặt sân</h2>
        
            <div class="booking-layout">
                <div class="booking-form-col">
                    <label>Ngày đặt</label>
                    <input type="date" id="bkDate" class="form-control" onchange="calcTotal()">

                    <label>Chọn Sân</label>
                    <select id="bkSan" class="form-control" onchange="calcTotal()">
                        <option value="">--Chọn Sân--</option>
                        @foreach (var san in Model)
                        {
                            <option value="@san.SanID" data-price="@san.GiaCoBan" data-name="@san.TenSan" data-type="@san.LoaiSan">@san.TenSan - @san.LoaiSan</option>
                        }
                    </select>

                    <label>Khung giờ (Có thể chọn nhiều)</label>
                    <div id="timeSlotGrid" class="time-slot-grid">
                    </div>

                    <label>Ghi Chú</label>
                    <textarea id="bkNote" class="form-control" placeholder="Nhập ghi chú..."></textarea>
                </div>

                <div class="booking-summary-col">
                    <h3>Tóm tắt đặt sân</h3>
                    <span class="summary-line">Ngày Đặt Sân: <strong id="sumDate">...</strong></span>
                    <span class="summary-line">Loại Sân: <strong id="sumType">...</strong></span>
                    <span class="summary-line">Khung giờ: <strong id="sumTime">...</strong></span>
                    <span class="summary-line">Ghi chú: <strong id="sumNote">...</strong></span>
                
                    <div class="summary-divider"></div>
                    <div class="summary-total"><span>Tổng Tiền:</span> <span id="sumTotalOrigin">0đ</span></div>
                
                    <div class="discount-row">
                        <input type="text" placeholder="Mã Giảm Giá">
                        <button>Sử dụng</button>
                    </div>
                
                    <div class="summary-total"><span>Thành Tiền:</span> <span id="sumTotalFinal" style="color: #dc3545;">0đ</span></div>
                    <button class="btn-primary-blue" onclick="submitBooking()">Đặt Sân</button>
                </div>
            </div>
        </div>
    </div>

    <div id="paymentModal" class="auth-modal-overlay">
        <div class="auth-modal modal-md">
            <button class="auth-close" onclick="closeModal('paymentModal')">×</button>
            <h2 class="auth-title">Thanh toán</h2>
            <div class="payment-content">
                <div class="qr-code-box">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=ChuyenKhoanPickleball" alt="QR Code">
                </div>
                <div class="payment-info">
                    <h4>Tài Khoản Thụ Hưởng</h4>
                    <h4>Pickleball Smash</h4>
                    <h2>STK: 123456789</h2>
                </div>
                <button class="btn-primary-blue" onclick="confirmPayment()">Đã Thanh Toán</button>
            </div>
        </div>
    </div>

    <div id="historyModal" class="auth-modal-overlay">
        <div class="auth-modal modal-xl">
            <button class="auth-close" onclick="closeModal('historyModal')">×</button>
            <h2 class="auth-title" style="text-align: left;">Lịch sử thanh toán</h2>
        
            <div class="history-filters">
                <input type="date" placeholder="--Chọn ngày--">
                <select><option>--Giờ bắt đầu--</option></select>
                <select><option>--Giờ kết thúc--</option></select>
                <select><option>--Loại sân--</option></select>
                <button class="btn-search-blue">Tìm kiếm</button>
            </div>

            <div class="history-table-wrapper">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Mã hoá đơn</th>
                            <th>Ngày thanh toán</th>
                            <th>Loại sân</th>
                            <th>Khung giờ</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="detailModal" class="auth-modal-overlay">
        <div class="auth-modal modal-xl">
            <button class="auth-close" onclick="closeModal('detailModal')">×</button>
            <div class="detail-layout">
            
                <div class="detail-left-col">
                    <img id="dtImg" src="" alt="Court Image" class="detail-img" />
                
                    <div class="detail-basic-info">
                        <h3 id="dtName">Tên sân</h3>
                        <p style="color: #666; font-size: 1.1rem; margin-bottom: 10px;">
                            <i class="fas fa-map-marker-alt" style="color: var(--primary-green);"></i> <span id="dtType">Loại sân</span>
                        </p>
                        <div class="detail-price">Giá: <span id="dtPrice">0</span> đ/giờ</div>
                        <p class="detail-desc" id="dtDesc">Mô tả sân...</p>
                    </div>
                </div>

                <div class="detail-info">
                    <div class="detail-date-picker">
                        <label style="font-weight: bold; font-size: 1.1rem; margin-bottom: 5px;">Chọn ngày và khung giờ:</label>
                        <input type="date" id="dtDate" onchange="fetchDetailSlots()" style="width: 100%;">
                    </div>

                    <div id="dtTimeSlotGrid" class="time-slot-grid" style="margin-bottom: 25px; max-height: 280px;">
                    </div>

                    <button class="btn-primary-blue" id="dtBtnBook" style="background: var(--primary-green); margin-top: auto;">Đặt Sân</button>
                </div>
            
            </div>
        </div>
    </div>
    <div id="loginModal" class="auth-modal-overlay">
        <div class="auth-modal">
            <button class="auth-close" onclick="closeAuthModal()">×</button>
            <h2 class="auth-title">Đăng nhập</h2>
            
            <div class="auth-role-tabs">
                <button type="button" class="auth-role-btn active" onclick="setRole('KhachHang', this)">Khách hàng</button>
                <button type="button" class="auth-role-btn" onclick="setRole('NhanVien', this)">Nhân viên</button>
            </div>
            <input type="hidden" id="loginRole" value="KhachHang" />

            <div id="loginError" class="auth-api-error"></div>

            <div class="auth-form-group">
                <input type="text" id="loginUsername" class="auth-input blur-validate" placeholder="Tên đăng nhập hoặc email đăng ký">
                <span class="auth-error"></span>
            </div>
            <div class="auth-form-group">
                <input type="password" id="loginPassword" class="auth-input blur-validate" placeholder="Mật khẩu">
                <span class="auth-error"></span>
            </div>

            <div class="auth-options">
                <label><input type="checkbox"> Nhớ đăng nhập</label>
                <a href="#" style="color: var(--text-dark); text-decoration: none; font-weight: bold;">Quên mật khẩu ?</a>
            </div>

            <button type="button" class="auth-btn-submit auth-btn-login" onclick="submitLogin()">Đăng nhập</button>

            <div class="auth-switch-text">
                Nếu chưa có tài khoản vui lòng <a href="javascript:void(0)" onclick="openAuthModal('register')">Đăng ký</a>
            </div>

            <button type="button" class="auth-google-btn">
                <i class="fab fa-google"></i> Đăng nhập bằng tài khoản Google
            </button>
        </div>
    </div>

    <div id="registerModal" class="auth-modal-overlay">
        <div class="auth-modal" style="width: 600px; max-width: 95%;">
            <button class="auth-close" onclick="closeAuthModal()">×</button>
            <h2 class="auth-title">Đăng ký tài khoản</h2>

            <div id="registerError" class="auth-api-error"></div>

            <div class="register-grid">
                <div class="auth-form-group">
                    <input type="text" id="regUsername" class="auth-input blur-validate" placeholder="Tên đăng nhập *">
                    <span class="auth-error"></span>
                </div>
                <div class="auth-form-group">
                    <input type="text" id="regFullName" class="auth-input" placeholder="Họ và tên">
                    <span class="auth-error"></span>
                </div>

                <div class="auth-form-group">
                    <input type="password" id="regPassword" class="auth-input blur-validate" placeholder="Mật khẩu mới *">
                    <span class="auth-error"></span>
                </div>
                <div class="auth-form-group">
                    <input type="text" id="regPhone" class="auth-input blur-validate" placeholder="Số điện thoại *">
                    <span class="auth-error"></span>
                </div>

                <div class="auth-form-group">
                    <input type="password" id="regConfirmPassword" class="auth-input blur-validate" placeholder="Nhập lại mật khẩu *">
                    <span class="auth-error"></span>
                </div>
                <div class="auth-form-group">
                    <input type="email" id="regEmail" class="auth-input blur-validate" placeholder="Email *">
                    <span class="auth-error"></span>
                </div>

                <div class="auth-form-group">
                    <input type="date" id="regDob" class="auth-input" title="Ngày sinh">
                </div>
                <div class="auth-form-group">
                    <select id="regGender" class="auth-input">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                </div>
            </div>

            <button type="button" class="auth-btn-submit auth-btn-register" onclick="submitRegister()" style="margin-top: 15px;">Đăng ký</button>

            <div class="auth-switch-text">
                Đã có tài khoản? <a href="javascript:void(0)" onclick="openAuthModal('login')">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
    <div id="profileModal" class="auth-modal-overlay">
        <div class="auth-modal modal-md">
            <button class="auth-close" onclick="closeModal('profileModal')">×</button>
            <h2 class="auth-title">Thông tin cá nhân</h2>
            
            <div class="profile-header-wrap">
                <div class="profile-avatar-large">
                    <i class="fas fa-user-circle"></i>
                    <span>Ảnh đại diện</span>
                </div>
                <button class="btn-edit-profile" onclick="openEditProfileModal()">
                    <i class="fas fa-edit"></i> Chỉnh sửa
                </button>
            </div>

            <div class="profile-info-grid">
                <div class="profile-info-item"><h5>Họ và tên</h5><p id="lblHoTen">...</p></div>
                <div class="profile-info-item"><h5>Ngày sinh:</h5><p id="lblNgaySinh">...</p></div>
                <div class="profile-info-item"><h5>Số điện thoại:</h5><p id="lblSDT">...</p></div>
                <div class="profile-info-item"><h5>Email:</h5><p id="lblEmail">...</p></div>
                <div class="profile-info-item"><h5>Mã khách hàng</h5><p id="lblMaKH">...</p></div>
                <div class="profile-info-item"><h5>Giới tính</h5><p id="lblGioiTinh">...</p></div>
            </div>
        </div>
    </div>


    <script>
            const loginModal = document.getElementById('loginModal');
            const registerModal = document.getElementById('registerModal');

            function openAuthModal(type) {
                closeAuthModal();
                if(type === 'login') loginModal.classList.add('active');
                else registerModal.classList.add('active');
            }

            function closeAuthModal() {
                loginModal.classList.remove('active');
                registerModal.classList.remove('active');
                document.querySelectorAll('.auth-error, .auth-api-error').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.auth-input').forEach(el => el.value = '');
            }

            function setRole(role, btn) {
                document.getElementById('loginRole').value = role;
                document.querySelectorAll('.auth-role-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }

            document.querySelectorAll('.blur-validate').forEach(input => {
                input.addEventListener('blur', function() {
                    const errSpan = this.nextElementSibling;
                    if(!this.value.trim()) {
                        errSpan.textContent = 'Không được để trống';
                        errSpan.style.display = 'block';
                    } else {
                        errSpan.style.display = 'none';
                    }
                });
            });

            async function submitLogin() {
                const user = document.getElementById('loginUsername');
                const pass = document.getElementById('loginPassword');
                const role = document.getElementById('loginRole').value;
                const errBox = document.getElementById('loginError');

                user.focus(); user.blur();
                pass.focus(); pass.blur();
                if(!user.value.trim() || !pass.value.trim()) return;

                const res = await fetch('/Account/Login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: user.value.trim(), password: pass.value.trim(), role: role })
                });
                const data = await res.json();

                if(data.success) {
                    window.location.reload();
                } else {
                    errBox.textContent = data.message;
                    errBox.style.display = 'block';
                }
            }

             async function submitRegister() {
                // 1. Lấy dữ liệu từ các ô input
                const user = document.getElementById('regUsername');
                const fname = document.getElementById('regFullName');
                const email = document.getElementById('regEmail');
                const phone = document.getElementById('regPhone');
                const dob = document.getElementById('regDob');
                const gender = document.getElementById('regGender');
                const pass = document.getElementById('regPassword');
                const cpass = document.getElementById('regConfirmPassword');
                const errBox = document.getElementById('registerError');

                // 2. Kích hoạt thông báo lỗi nếu để trống các trường bắt buộc
                [user, email, phone, pass, cpass].forEach(el => { el.focus(); el.blur(); });

                // Kiểm tra xem có trường bắt buộc nào bị trống không
                if (!user.value.trim() || !email.value.trim() || !phone.value.trim() || !pass.value.trim() || !cpass.value.trim()) {
                    return;
                }

                if (pass.value !== cpass.value) {
                    errBox.textContent = 'Mật khẩu xác nhận không khớp.';
                    errBox.style.display = 'block';
                    return;
                }

                // 3. Đóng gói dữ liệu gửi lên Server (Đã đổi sang key tiếng Anh)
                const payload = {
                    Username: user.value.trim(),
                    FullName: fname.value.trim(),
                    Email: email.value.trim(),
                    Phone: phone.value.trim(),
                    Dob: dob.value ? dob.value : null,
                    Gender: gender.value ? gender.value : null,
                    Password: pass.value.trim()
                };

                try {
                    const res = await fetch('/Account/Register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
        
                    const data = await res.json();
                    if (data.success) {
                        alert("Đăng ký thành công! Vui lòng đăng nhập.");
                        openAuthModal('login'); // Tự động mở form đăng nhập
                    } else {
                        errBox.textContent = data.message;
                        errBox.style.display = 'block';
                    }
                } catch (err) {
                    errBox.textContent = "Lỗi kết nối đến máy chủ!";
                    errBox.style.display = 'block';
                }
            }
            // ================= HÀM ĐÓNG MODAL CHUNG =================
            function closeModal(id) {
                document.getElementById(id).classList.remove('active');
            }

            // ================= XỬ LÝ THÔNG TIN CÁ NHÂN =================
            async function openProfileModal() {
                // Gọi API lấy thông tin
                try {
                    const res = await fetch('/Account/GetProfile');
                    if(res.ok) {
                        const data = await res.json();
                        // Hiển thị lên Popup
                        document.getElementById('lblHoTen').innerText = data.hoTen || 'Chưa cập nhật';
                        document.getElementById('lblEmail').innerText = data.email || 'Chưa cập nhật';
                        document.getElementById('lblSDT').innerText = data.sdt || 'Chưa cập nhật';
                        document.getElementById('lblNgaySinh').innerText = data.ngaySinh ? data.ngaySinh.split('-').reverse().join('/') : 'Chưa cập nhật';
                        document.getElementById('lblGioiTinh').innerText = data.gioiTinh || 'Nam';
                        document.getElementById('lblMaKH').innerText = data.maKhachHang;

                        // Lưu tạm data để dùng cho form Edit
                        window.currentProfileData = data;
                        
                        // Ẩn tất cả các popup khác và mở popup profile
                        document.querySelectorAll('.auth-modal-overlay').forEach(m => m.classList.remove('active'));
                        document.getElementById('profileModal').classList.add('active');
                    } else {
                        alert("Vui lòng đăng nhập để xem thông tin!");
                    }
                } catch(err) {
                    console.log("Lỗi tải thông tin:", err);
                }
            }

            function openEditProfileModal() {
                closeModal('profileModal');
                
                // Đổ dữ liệu có sẵn vào các ô input
                const data = window.currentProfileData;
                if(data) {
                    document.getElementById('updHoTen').value = data.hoTen || '';
                    document.getElementById('updEmail').value = data.email || '';
                    document.getElementById('updSDT').value = data.sdt || '';
                    document.getElementById('updNgaySinh').value = data.ngaySinh || '';
                    document.getElementById('updGioiTinh').value = data.gioiTinh || 'Nam';
                    
                    // Xóa trắng ô mật khẩu
                    document.getElementById('updOldPass').value = '';
                    document.getElementById('updNewPass').value = '';
                    document.getElementById('updConfirmPass').value = '';
                }
                
                document.getElementById('editProfileModal').classList.add('active');
            }

            async function submitUpdateProfile() {
                const newPass = document.getElementById('updNewPass').value;
                const confirmPass = document.getElementById('updConfirmPass').value;

                if (newPass && newPass !== confirmPass) {
                    alert("Mật khẩu xác nhận không khớp!");
                    return;
                }

                const payload = {
                    FullName: document.getElementById('updHoTen').value,
                    Email: document.getElementById('updEmail').value,
                    Phone: document.getElementById('updSDT').value,
                    Dob: document.getElementById('updNgaySinh').value,
                    Gender: document.getElementById('updGioiTinh').value,
                    OldPassword: document.getElementById('updOldPass').value,
                    NewPassword: newPass
                };

                try {
                    const res = await fetch('/Account/UpdateProfile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    
                    const result = await res.json();
                    if(result.success) {
                        alert(result.message);
                        closeModal('editProfileModal');
                        window.location.reload(); // Tải lại trang để cập nhật tên
                    } else {
                        alert(result.message);
                    }
                } catch(err) {
                    alert("Có lỗi xảy ra, vui lòng thử lại sau.");
                }
            }
    </script>
    <script>
            window.isLoggedIn = @(Context.Session.GetInt32("UserID") != null ? "true" : "false");
    </script>
    <script src="~/js/customer-booking.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <button id="chatbot-toggle" class="chatbot-toggle-btn">
        <i class="fas fa-comments"></i>
    </button>

    <div id="chatbot-window" class="chatbot-window" style="display: none;">
        <div class="chatbot-header">
            <h4><i class="fas fa-robot"></i> Trợ lý Pickleball</h4>
            <button onclick="toggleChatbot()" style="background:none; border:none; color:white; cursor:pointer;">✖</button>
        </div>
        <div id="chatbot-messages" class="chatbot-messages">
            <div class="msg ai-msg">Chào bạn! Tôi có thể giúp gì cho việc đặt sân Pickleball hôm nay?</div>
        </div>
        <div class="chatbot-input-area">
            <input type="text" id="chatInput" placeholder="Nhập câu hỏi của bạn..." onkeypress="handleChatKeyPress(event)" />
            <button onclick="sendChatMessage()"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>
</body>
</html>