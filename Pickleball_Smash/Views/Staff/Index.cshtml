@model Pickleball_Smash.Models.ViewModels.StaffDashboardViewModel

@{
    ViewData["Title"] = "Trang Chủ Nhân Viên";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="court-grid-wrap">
    
    <form method="get" asp-action="Index" id="filterForm" class="manager-filters mb-4" style="display: flex; gap: 15px; flex-wrap: wrap;">
        
        <div class="search-wrapper">
            <input type="text" name="searchQuery" id="searchInput" class="staff-filter-input w-100" placeholder="🔍 Tìm kiếm tên sân..." value="@Model.SearchQuery" autocomplete="off" />
            <ul id="autocomplete-list"></ul>
        </div>

        <select name="trangThai" class="staff-filter-input" onchange="document.getElementById('filterForm').submit();">
            <option value="">-- Trạng thái --</option>
            <option value="Trống" selected="@(Model.SelectedTrangThai == "Trống")">Trống</option>
            <option value="Bận" selected="@(Model.SelectedTrangThai == "Bận")">Bận</option>
        </select>

        <select name="loaiSan" class="staff-filter-input" onchange="document.getElementById('filterForm').submit();">
            <option value="">-- Loại sân --</option>
            <option value="Trong nhà" selected="@(Model.SelectedLoaiSan == "Trong nhà")">Trong nhà</option>
            <option value="Ngoài trời" selected="@(Model.SelectedLoaiSan == "Ngoài trời")">Ngoài trời</option>
        </select>

    </form>

    @if (!Model.DanhSachSan.Any())
    {
        <div class="text-center py-5 w-100 table-card">
            <i class="fas fa-search" style="font-size: 3.5rem; color: var(--manager-border); margin-bottom: 15px;"></i>
            <h4 style="color: var(--manager-text); font-weight: 700;">Không có sân phù hợp</h4>
            <p style="color: #666;">Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
            <a href="/Staff" class="btn" style="background: var(--manager-green-700); color: #fff; padding: 10px 24px; border-radius: 10px; font-weight: 600; text-decoration: none; margin-top: 10px; display: inline-block;">Xóa bộ lọc</a>
        </div>
    }
    else
    {
        <div class="court-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;">
            @foreach (var san in Model.DanhSachSan)
            {
                <article class="court-card">
                    <div class="court-img-wrap">
                        <img src="@san.AnhDaiDienUrl" alt="@san.TenSan" />
                        <span class="status-badge @san.TrangThai">@san.TrangThai</span>
                    </div>
                    <div class="court-info">
                        <h3>@san.TenSan</h3>
                        <p><i class="fas fa-map-marker-alt" style="color: var(--manager-green-500); margin-right: 6px;"></i>@san.LoaiSan</p>
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchInput");
            const autocompleteList = document.getElementById("autocomplete-list");

            searchInput.addEventListener("input", async function () {
                let term = this.value;
                if (!term) {
                    autocompleteList.style.display = "none";
                    return;
                }

                let response = await fetch(`/Staff/SuggestCourts?term=${encodeURIComponent(term)}`);
                if (response.ok) {
                    let data = await response.json();
                    autocompleteList.innerHTML = "";
                    if (data.length > 0) {
                        data.forEach(item => {
                            let li = document.createElement("li");
                            li.className = "list-group-item";
                            li.innerHTML = `<strong>${item.substring(0, term.length)}</strong>${item.substring(term.length)}`;
                            li.addEventListener("click", function () {
                                searchInput.value = item;
                                autocompleteList.style.display = "none";
                                document.getElementById("filterForm").submit();
                            });
                            autocompleteList.appendChild(li);
                        });
                        autocompleteList.style.display = "block";
                    } else {
                        autocompleteList.style.display = "none";
                    }
                }
            });

            document.addEventListener("click", function (e) {
                if (e.target !== searchInput) {
                    autocompleteList.style.display = "none";
                }
            });
        });
    </script>
}