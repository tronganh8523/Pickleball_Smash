@model IEnumerable<Pickleball_Smash.Models.SanPickleball>

@{
    ViewData["Title"] = "Trang Chủ - Pickleball Smash";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
}

<!-- Hero Section -->
<div class="hero mb-5">
    <h1><i class="fas fa-badminton"></i> Pickleball Smash</h1>
    <p>Tìm và đặt sân pickleball dễ dàng, nhanh chóng</p>
    <a href="#danh-sach-san" class="btn btn-light btn-lg">
        <i class="fas fa-search"></i> Tìm Sân Ngay
    </a>
</div>

<!-- Thống Kê -->
<div class="row mb-5">
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-primary"><i class="fas fa-th"></i> @Model.Count()</h3>
                <p class="card-text">Sân Pickleball</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-success"><i class="fas fa-users"></i> 5000+</h3>
                <p class="card-text">Khách Hàng</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-info"><i class="fas fa-star"></i> 4.8/5</h3>
                <p class="card-text">Đánh Giá</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-warning"><i class="fas fa-ticket-alt"></i> Khuyến Mãi</h3>
                <p class="card-text">Hàng Tuần</p>
            </div>
        </div>
    </div>
</div>

<!-- Danh Sách Sân -->
<section id="danh-sach-san" class="mb-5">
    <h2 class="mb-4"><i class="fas fa-th"></i> Danh Sách Sân Nổi Bật</h2>
    <div class="row">
        @if (Model.Any())
        {
            @foreach (var san in Model)
            {
                <div class="col-lg-3 mb-4">
                    <div class="card h-100">
                        <img src="https://via.placeholder.com/300x200?text=San+Pickleball" class="card-img-top" alt="@san.TenSan">
                        <div class="card-body">
                            <h5 class="card-title">@san.TenSan</h5>
                            <p class="card-text">@san.MoTa</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-info">@san.LoaiSan</span>
                                <strong>@(san.GiaCoBan?.ToString("N0") ?? "0") VNĐ/h</strong>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <span class="text-muted small">Chức năng đặt sân đang tạm ẩn.</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center">Hiện chưa có sân trong hệ thống.</div>
            </div>
        }
    </div>
    <div class="text-center mt-4">
        <span class="text-muted">Danh sách hiển thị tại trang chủ.</span>
    </div>
</section>

<!-- Tính Năng Nổi Bật -->
<section class="mb-5 py-5 home-feature-section">
    <h2 class="text-center mb-4"><i class="fas fa-star"></i> Tại Sao Chọn Pickleball Smash?</h2>
    <div class="row">
        <div class="col-md-3 text-center mb-3">
            <div class="home-feature-icon">
                <i class="fas fa-lightning-bolt"></i>
            </div>
            <h5>Đặt Sân Nhanh</h5>
            <p>Chỉ 3 bước, 1 phút để hoàn tất đặt sân.</p>
        </div>
        <div class="col-md-3 text-center mb-3">
            <div class="home-feature-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h5>An Toàn & Tin Cậy</h5>
            <p>Các sân kiểm duyệt kỹ lưỡng, đáng tin cậy.</p>
        </div>
        <div class="col-md-3 text-center mb-3">
            <div class="home-feature-icon">
                <i class="fas fa-gift"></i>
            </div>
            <h5>Ưu Đãi Tuyệt Vời</h5>
            <p>Voucher, khuyến mãi hàng tuần cho thành viên.</p>
        </div>
        <div class="col-md-3 text-center mb-3">
            <div class="home-feature-icon">
                <i class="fas fa-headset"></i>
            </div>
            <h5>Hỗ Trợ 24/7</h5>
            <p>Đội hỗ trợ khách hàng luôn sẵn sàng giúp.</p>
        </div>
    </div>
</section>
